<Application x:Class="KotonLive.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Le MÊME dictionnaire que Koton Studio, pris dans son assembly : les fenêtres partagées
                 (LiveWindow, éditeurs de plugins, dialogues d'effets) résolvent leurs StaticResource dans
                 l'application qui les héberge, donc sans ça elles ne trouveraient ni le thème ni les styles
                 nommés (okButton, TinyButton…) et planteraient au chargement du XAML. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KotonStudio;component/Theme/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
