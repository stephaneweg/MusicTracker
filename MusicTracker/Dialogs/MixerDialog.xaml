<Window x:Class="MusicTracker.Dialogs.MixerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:MusicTracker.Controls"
        xmlns:local="clr-namespace:MusicTracker.Dialogs"
        xmlns:loc="clr-namespace:MusicTracker.Localization"
        mc:Ignorable="d" Foreground="{StaticResource CommonForeground}"
        Title="{loc:Tr 'Mixer'}" Width="820" Height="520" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <local:PanTextConverter x:Key="panText"/>
        <!-- Compact M/S toggle: grey by default, red when active. -->
        <Style x:Key="MixToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="3" Background="#3A3A46" BorderBrush="#555555" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C0392B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E05543"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TinyButton est maintenant global (App.xaml) : réutilisable par toutes les Windows. -->

        <!-- Vertical slider (fader). -->
        <Style x:Key="Fader" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="MinHeight" Value="140"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CommonBackground}" BorderBrush="{StaticResource OutlineColorBrush}" BorderThickness="3" CornerRadius="8">
        <DockPanel>
            <!-- Draggable title bar. -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CommonBackground}" ctrl:WindowDrag.Enable="True" CornerRadius="6,6,0,0" Padding="20,12,20,8">
                <DockPanel>
                    <TextBlock Text="{loc:Tr 'Mixer'}" Foreground="{StaticResource CommonForeground}" FontSize="15" FontWeight="Bold"/>
                    <TextBlock DockPanel.Dock="Right" Text="{loc:Tr 'MixerHint'}" Foreground="#9AA" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,14">
                <Button Content="{loc:Tr 'Close'}" Style="{StaticResource okButton}" Padding="18,4" Cursor="Hand" Click="Close_Click"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Strips par piste (scroll horizontal si beaucoup de pistes). -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="8,4,4,8">
                    <ItemsControl Name="list">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Séparateur avant la strip Master. -->
                <Rectangle Grid.Column="1" Width="1" Fill="#444" Margin="4,10,4,10"/>

                <!-- Strip Master (fixe à droite). -->
                <Border Grid.Column="2" Name="masterHost" Background="#2A2A34" CornerRadius="5" Padding="8,10" Margin="4,4,10,8" Width="86">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Tr 'MasterBus'}" Foreground="#1FB6C3" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <!-- Vu-mètre master : deux barres verticales L/R alimentées par un timer. -->
                        <Grid Height="140" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#111" CornerRadius="1" Margin="4,0">
                                <Rectangle Name="masterMeterL" Fill="#1FB6C3" VerticalAlignment="Bottom" Height="0"/>
                            </Border>
                            <Border Grid.Column="1" Background="#111" CornerRadius="1" Margin="4,0">
                                <Rectangle Name="masterMeterR" Fill="#1FB6C3" VerticalAlignment="Bottom" Height="0"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{loc:Tr 'Inserts'}" Foreground="#999" FontSize="10" Margin="0,4,0,3"/>
                        <ItemsControl Name="masterInsertsList"/>
                        <Button Content="{loc:Tr 'AddFxDots'}" Style="{StaticResource TinyButton}" Click="MasterAddFx_Click" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
