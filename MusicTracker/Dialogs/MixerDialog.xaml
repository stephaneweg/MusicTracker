<Window x:Class="MusicTracker.Dialogs.MixerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:MusicTracker.Controls"
        xmlns:local="clr-namespace:MusicTracker.Dialogs"
        xmlns:loc="clr-namespace:MusicTracker.Localization"
        mc:Ignorable="d" Foreground="{StaticResource CommonForeground}"
        Title="{loc:Tr 'Mixer'}" Width="470" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <local:PanTextConverter x:Key="panText"/>
        <!-- Compact M/S toggle: grey by default, red when active (self-contained; the header's MuteToggle/SoloToggle
             styles live in the timeline UserControl and aren't visible from this window). -->
        <Style x:Key="MixToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="4" Background="#3A3A46" BorderBrush="#555555" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C0392B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E05543"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CommonBackground}" BorderBrush="{StaticResource OutlineColorBrush}" BorderThickness="3" CornerRadius="8">
        <DockPanel>
            <!-- Draggable title bar (no ✕ — like the other dialogs; closes via the bottom button / Esc). -->
            <Border DockPanel.Dock="Top" Background="{StaticResource CommonBackground}" ctrl:WindowDrag.Enable="True" CornerRadius="6,6,0,0" Padding="20,14,20,8">
                <TextBlock Text="{loc:Tr 'Mixer'}" Foreground="{StaticResource CommonForeground}" FontSize="15" FontWeight="Bold"/>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,16">
                <Button Content="{loc:Tr 'Close'}" Style="{StaticResource okButton}" Padding="18,4" Cursor="Hand" Click="Close_Click"/>
            </StackPanel>

            <ListBox Name="list" Margin="12,4,12,8" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2C2C38" CornerRadius="5" Margin="0,0,0,6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CommonForeground}" Margin="0,0,0,6"/>
                                <!-- Volume -->
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="{loc:Tr 'Vol'}" Width="34" Foreground="#999999" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Width="42" Text="{Binding Volume, StringFormat={}{0:P0}}" Foreground="#999999" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Slider Minimum="0" Maximum="1.5" SmallChange="0.05" VerticalAlignment="Center" Margin="4,0"
                                            Value="{Binding Volume, Mode=TwoWay}"/>
                                </DockPanel>
                                <!-- Pan -->
                                <DockPanel>
                                    <TextBlock Text="{loc:Tr 'Pan'}" Width="34" Foreground="#999999" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Width="52" Text="{Binding Pan, Converter={StaticResource panText}}" Foreground="#999999" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Content="C" Width="22" Height="20" Margin="4,0,0,0" Cursor="Hand" Click="Center_Click" ToolTip="{loc:Tr 'CentrerLePanoramique'}"/>
                                    <Slider Minimum="-1" Maximum="1" SmallChange="0.05" TickFrequency="1" TickPlacement="BottomRight" VerticalAlignment="Center" Margin="4,0"
                                            Value="{Binding Pan, Mode=TwoWay}"/>
                                </DockPanel>
                                <!-- Mute / Solo -->
                                <StackPanel Orientation="Horizontal" Margin="34,6,0,0">
                                    <ToggleButton Content="M" Width="26" Height="22" Style="{StaticResource MixToggle}" IsChecked="{Binding Mute, Mode=TwoWay}" ToolTip="{loc:Tr 'MuetSilenceCettePiste'}"/>
                                    <ToggleButton Content="S" Width="26" Height="22" Margin="4,0,0,0" Style="{StaticResource MixToggle}" IsChecked="{Binding Solo, Mode=TwoWay}" ToolTip="{loc:Tr 'SoloNEntendreQueLesPistes'}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
