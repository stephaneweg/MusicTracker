<Window x:Class="MusicTracker.Dialogs.TrackSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MusicTracker.Controls"
        xmlns:loc="clr-namespace:MusicTracker.Localization"
        Title="{loc:Tr 'PistesAExporter'}"
        Width="440" MinHeight="280" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="{StaticResource CommonBackground}" BorderBrush="{StaticResource OutlineColorBrush}" BorderThickness="3" CornerRadius="8">
        <StackPanel Margin="20,16,20,16">
            <StackPanel Orientation="Horizontal" ctl:WindowDrag.Enable="True" Margin="0,0,0,10">
                <TextBlock Text="📤" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource CommonForeground}"/>
                <TextBlock Text="{loc:Tr 'PistesAExporter'}" Foreground="{StaticResource CommonForeground}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{loc:Tr 'CocheLesPistesQueTuVeuxExporter'}" Foreground="{StaticResource SecondaryForeground}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="{loc:Tr 'ToutCocher'}" Click="AllCheck_Click" Padding="10,3" Margin="0,0,6,0" Cursor="Hand"
                        Background="Transparent" Foreground="{StaticResource AccentBrightBrush}" BorderThickness="0"/>
                <Button Content="{loc:Tr 'ToutDecocher'}" Click="NoneCheck_Click" Padding="10,3" Cursor="Hand"
                        Background="Transparent" Foreground="{StaticResource AccentBrightBrush}" BorderThickness="0"/>
            </StackPanel>

            <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" MaxHeight="380">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="lstTracks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Include, Mode=TwoWay}" Margin="2,3,2,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource CommonForeground}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Tag}" Foreground="{StaticResource SecondaryForeground}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{loc:Tr 'Annuler'}" Click="Cancel_Click" Padding="14,5" Margin="0,0,8,0" Cursor="Hand"
                        Background="Transparent" Foreground="{StaticResource SecondaryForeground}" BorderThickness="0"/>
                <Button Content="{loc:Tr 'Exporter'}" Click="Ok_Click" Padding="14,5" Cursor="Hand"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
