<Window x:Class="MusicTracker.Dialogs.ReportBugDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:MusicTracker.Localization"
        mc:Ignorable="d" Foreground="{StaticResource CommonForeground}"
        Title="{loc:Tr 'ReportABug'}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource CommonBackground}" BorderBrush="{StaticResource OutlineColorBrush}" BorderThickness="3" CornerRadius="8">
        <StackPanel Margin="24,18">
            <TextBlock x:Name="titleBar" Text="{loc:Tr 'ReportABugOrASuggestion'}" Foreground="{StaticResource CommonForeground}"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock x:Name="txtIntro" Text="{loc:Tr 'DescribeWhatYouWereDoingWhat'}"
                       Foreground="{StaticResource CommonForeground}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <TextBlock Text="{loc:Tr 'Type'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="cboType" HorizontalAlignment="Left" Width="220" SelectedIndex="0" Margin="0,0,0,12">
                <ComboBoxItem Content="{loc:Tr 'Bug'}"/>
                <ComboBoxItem Content="{loc:Tr 'Suggestion'}"/>
                <ComboBoxItem Content="{loc:Tr 'Exception'}"/>
            </ComboBox>

            <TextBlock Text="{loc:Tr 'Title'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtTitle" Style="{StaticResource labelTextBox}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

            <TextBlock Text="{loc:Tr 'Description'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="txtDescription" Style="{StaticResource labelTextBox}" HorizontalAlignment="Stretch"
                     Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" Margin="0,0,0,12"/>

            <!-- Mode « plantage » uniquement : ce qui sera joint au rapport, montré tel quel pour que
                 l'utilisateur sache exactement ce qu'il envoie. NoWrap : une pile d'appels tronquée à droite
                 reste lisible, repliée elle ne l'est plus. -->
            <StackPanel x:Name="panException" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr 'TechnicalDetail'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtException" Style="{StaticResource labelTextBox}" HorizontalAlignment="Stretch"
                         Height="150" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Opacity="0.85"
                         TextWrapping="NoWrap" VerticalContentAlignment="Top" Margin="0,0,0,12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </StackPanel>

            <CheckBox x:Name="chkAttachProject" Content="{loc:Tr 'AttachTheCurrentProjectJSONFolded'}"
                      IsChecked="True" Margin="0,0,0,4"/>
            <CheckBox x:Name="chkAttachTemplate" Content="{loc:Tr 'AlsoAttachTheAssociatedModel'}" IsChecked="True" Margin="18,0,0,10"/>

            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,0,0,4"
                       Text="{loc:Tr 'TheReportIsPublishedAsA'}"/>

            <TextBlock x:Name="txtStatus" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{loc:Tr 'Cancel'}" Style="{StaticResource cancelButton}" x:Name="btnCancel" Padding="16,4" Margin="0,0,8,0" Cursor="Hand" Click="btnCancel_Click"/>
                <Button Content="{loc:Tr 'Send'}" x:Name="btnSend" Style="{StaticResource okButton}" Padding="18,4" Cursor="Hand" Click="btnSend_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
