<Window x:Class="MusicTracker.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MusicTracker.Controls"
        xmlns:loc="clr-namespace:MusicTracker.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{loc:Tr 'Settings'}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource CommonBackground}" BorderBrush="{StaticResource OutlineColorBrush}" BorderThickness="3" CornerRadius="8">
        <StackPanel Margin="26,22" MinWidth="360">
            <Border ctl:WindowDrag.Enable="True" Background="{StaticResource CommonBackground}" CornerRadius="5,5,0,0"
                    Margin="-26,-22,-26,18" Padding="26,22,26,10">
                <TextBlock Text="{loc:Tr 'Settings'}" Foreground="{StaticResource CommonForeground}"
                           FontSize="16" FontWeight="Bold"/>
            </Border>

            <!-- ===== Langue / Language ===== -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Tr 'Language'}" Foreground="{StaticResource CommonForeground}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" x:Name="cboLanguage"/>
            </Grid>

            <!-- ===== Général ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr 'SoundFont'}" Foreground="{StaticResource CommonForeground}"
                           VerticalAlignment="Center" Margin="0,0,12,10"/>
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" x:Name="btnBrowseSoundFont" Content="…" Width="28" Margin="6,0,0,0"
                            Click="btnBrowseSoundFont_Click" Cursor="Hand"
                            ToolTip="{loc:Tr 'PickASf2FileFromDisk'}"/>
                    <ComboBox x:Name="cboSoundFont"/>
                </DockPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr 'SampleRate'}" Foreground="{StaticResource CommonForeground}"
                           VerticalAlignment="Center" Margin="0,0,12,10"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cboSampleRate" Margin="0,0,0,10"/>

                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="chkMetricVelocity"
                          Foreground="{StaticResource CommonForeground}" Margin="0,0,0,10"
                          Content="{loc:Tr 'AccentuerLesTempsForts'}"
                          ToolTip="{loc:Tr 'DecochePourUneFrappeUniforme'}"/>
            </Grid>

            <!-- ===== Éditeur de riff ===== -->
            <TextBlock Text="{loc:Tr 'RIFFEDITOR'}" Foreground="{StaticResource AccentBrightBrush}"
                       FontWeight="SemiBold" FontSize="11" Margin="0,14,0,4"/>
            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr 'EntrySpeedSlicesS'}" Foreground="{StaticResource CommonForeground}"
                           VerticalAlignment="Center" Margin="0,0,12,10"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtRiffSpeed" VerticalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr 'EntryPrecision'}" Foreground="{StaticResource CommonForeground}"
                           VerticalAlignment="Center" Margin="0,0,12,10"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cboRiffSnap" VerticalAlignment="Center" Margin="0,0,0,10"/>
            </Grid>

            <!-- ===== Détection de note (audio) ===== -->
            <TextBlock Text="{loc:Tr 'NOTEDETECTIONAUDIO'}" Foreground="{StaticResource AccentBrightBrush}"
                       FontWeight="SemiBold" FontSize="11" Margin="0,14,0,4"/>
            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="chkAudioScaleSnap" Foreground="{StaticResource CommonForeground}"
                          Margin="0,0,0,10"
                          Content="{loc:Tr 'SnapToScale'}"
                          ToolTip="{loc:Tr 'IfUncheckedDefaultAudioDetectionIs'}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr 'ReAttackSensitivityDetache'}" Foreground="{StaticResource CommonForeground}"
                           VerticalAlignment="Center" Margin="0,0,12,10"/>
                <Slider Grid.Row="1" Grid.Column="1" x:Name="sldOnset" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,0,10"
                        ToolTip="{loc:Tr 'HigherARepeatedBowStrokeOn'}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr 'AnalysisWindowLatency'}" Foreground="{StaticResource CommonForeground}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cboFrameSize" VerticalAlignment="Center"
                          ToolTip="{loc:Tr 'SmallerLowerLatencyAndBetterDetache'}"/>
            </Grid>

            <!-- ===== IA ===== -->
            <TextBlock Text="{loc:Tr 'ARTIFICIALINTELLIGENCE'}" Foreground="{StaticResource AccentBrightBrush}"
                       FontWeight="SemiBold" FontSize="11" Margin="0,14,0,4"/>
            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,10"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Tr 'ManageAPIKeys'}" Style="{StaticResource okButton}" Click="btnApiKeys_Click" Padding="14,5" Cursor="Hand"/>
                <TextBlock Text="{loc:Tr 'APIKeysStoredLocallySeveralPer'}" Foreground="{StaticResource SecondaryForeground}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock Text="{loc:Tr 'AUDIO'}" Foreground="{StaticResource AccentBrightBrush}"
                       FontWeight="SemiBold" FontSize="11" Margin="0,14,0,4"/>
            <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,0,0,10"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Tr 'InstrumentBoost'}" Style="{StaticResource okButton}" Click="btnBoost_Click" Padding="14,5" Cursor="Hand"/>
                <TextBlock Text="{loc:Tr 'AdjustPlaybackVolumePerInstrumentPiano'}" Foreground="{StaticResource SecondaryForeground}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock x:Name="txtNote" Text="{loc:Tr 'ChangingTheSoundFontReloadsTheInstrument'}"
                       Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0" MaxWidth="360"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{loc:Tr 'Cancel'}" Style="{StaticResource cancelButton}" Click="btnCancel_Click" Padding="16,4" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="{loc:Tr 'Apply'}" Style="{StaticResource okButton}" Click="btnOk_Click" Padding="16,4" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

