<Window x:Class="MusicTracker.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Foreground="{StaticResource CommonForeground}"
        Title="Mise à jour" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource CommonBackground}" BorderBrush="{StaticResource OutlineColorBrush}" BorderThickness="3" CornerRadius="8">
        <StackPanel Margin="26,22">
            <TextBlock Text="Nouvelle version disponible" Foreground="{StaticResource AccentBrush}"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock x:Name="txtVersions" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,14"/>

            <TextBlock x:Name="txtNotesLabel" Text="Nouveautés" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Border x:Name="notesBox" Background="#22000000" CornerRadius="6" Padding="12,10" MaxHeight="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtNotes" TextWrapping="Wrap" Opacity="0.9"/>
                </ScrollViewer>
            </Border>

            <TextBlock Text="La mise à jour sera téléchargée puis lancée ; l'application se fermera pour l'installer."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,12,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Plus tard" Style="{StaticResource cancelButton}" x:Name="btnLater" Padding="16,4" Margin="0,0,8,0" Cursor="Hand" Click="btnLater_Click"/>
                <Button Content="Mettre à jour" x:Name="btnUpdate" Style="{StaticResource okButton}" Padding="18,4" Cursor="Hand" Click="btnUpdate_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
