<Window x:Class="MusicTracker.Dialogs.KotonPluginEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugin"
        SizeToContent="WidthAndHeight"
        MinWidth="360" MinHeight="200"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource CommonForeground}"
        Background="{StaticResource CommonBackground}"
        ShowInTaskbar="False" Closing="Window_Closing">
    <!--
    Fenetre WPF simple qui embarque le UserControl retourne par IKotonPlugin.CreateEditor().
    Contrairement a VstPluginWindow, aucun HwndHost ni classe Win32 native n'est necessaire — un
    plugin Koton natif est du WPF pur, WPF sait le layouter en direct sans le probleme d'airspace.
    -->
    <Border x:Name="hostBorder" Padding="8" MinWidth="360" MinHeight="200"/>
</Window>
