<Window x:Class="MusicTracker.Dialogs.CadenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MusicTracker.Controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:MusicTracker.Localization"
        mc:Ignorable="d"
        Title="{loc:Tr 'GenerateACadence'}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource CommonBackground}" BorderBrush="{StaticResource OutlineColorBrush}" BorderThickness="3" CornerRadius="8">
        <StackPanel Margin="26,22" MinWidth="320">
            <StackPanel Background="{StaticResource CommonBackground}"  ctl:WindowDrag.Enable="True"  Orientation="Horizontal" Margin="0,0,0,2" HorizontalAlignment="Stretch" >
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Foreground="{StaticResource CommonForeground}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{loc:Tr 'AChordProgressionInThePiece'}"
                       Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16" MaxWidth="320"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr 'Bars'}" Foreground="#BBBBBB" VerticalAlignment="Center" Margin="0,4,12,4"/>
                <TextBox x:Name="txtMeasures" Grid.Row="0" Grid.Column="1" Width="70" HorizontalAlignment="Left" Text="4" Margin="0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr 'ChordsBar'}" Foreground="#BBBBBB" VerticalAlignment="Center" Margin="0,4,12,4"/>
                <TextBox x:Name="txtChordsPerMeasure" Grid.Row="1" Grid.Column="1" Width="70" HorizontalAlignment="Left" Text="1" Margin="0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr 'FromDegree'}" Foreground="#BBBBBB" VerticalAlignment="Center" Margin="0,4,12,4"/>
                <ComboBox x:Name="cboDegree" Grid.Row="2" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,4"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr 'Style'}" Foreground="#BBBBBB" VerticalAlignment="Center" Margin="0,4,12,4"/>
                <ComboBox x:Name="cboStyle" Grid.Row="3" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,4"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr 'RythmeArticulation'}" Foreground="#BBBBBB" VerticalAlignment="Center" Margin="0,4,12,4"/>
                <ComboBox x:Name="cboRhythm" Grid.Row="4" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,4"
                          ToolTip="{loc:Tr 'CommentChaqueAccordEstJouePlaque'}"/>
            </Grid>

            <CheckBox x:Name="chkBass" Content="{loc:Tr 'AjouterLaBasseFondamentale'}" Foreground="#DDDDDD" Margin="0,12,0,0"/>
            <CheckBox x:Name="chkVoiceLead" Content="{loc:Tr 'ConduiteDesVoixRenversementsAutomatiques'}" Foreground="#DDDDDD" Margin="0,6,0,0" IsChecked="True"
                      ToolTip="{loc:Tr 'ChoisitLeRenversementDeChaqueAccord'}"/>
            <CheckBox x:Name="chkOpen" Content="{loc:Tr 'VoicingOuvertEcarte'}" Foreground="#DDDDDD" Margin="0,6,0,0"
                      ToolTip="{loc:Tr 'EcarteChaqueAccordPositionOuverteAu'}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{loc:Tr 'Annuler'}" Style="{StaticResource cancelButton}" Click="btnCancel_Click" Padding="16,4" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="{loc:Tr 'Generer'}" Style="{StaticResource okButton}" Click="btnOk_Click" Padding="16,4" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
