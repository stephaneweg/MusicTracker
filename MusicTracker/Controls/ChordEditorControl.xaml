<UserControl x:Class="MusicTracker.Controls.ChordEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MusicTracker.Controls"
             xmlns:loc="clr-namespace:MusicTracker.Localization">
    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,1"/>
        </Style>
        <!-- Inherit the app's themed ComboBox look (implicit style keyed by type), just fix the width/alignment. -->
        <Style x:Key="Cb" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="180"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Num" TargetType="TextBox">
            <Setter Property="Width" Value="60"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </UserControl.Resources>
    <!-- L'accord ne décrit QUE l'harmonie : degré / fondamentale / couleur / suspension / mode forcé (+ sa durée
         sur la lane). Tout le « comment on le joue » (style, basse, voicing, octave, renversement, grille
         d'accompagnement, cellule mélodique) appartient désormais au module « Articulation d'accord », posé sur
         une piste instrument. La lane Accords est silencieuse : elle ne fait que fournir l'accord au contexte. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2,0,12,0">
            <TextBlock Style="{StaticResource Lbl}" Text="{loc:Tr 'DegreDansLaTonalite'}"/>
            <ComboBox Style="{StaticResource Cb}" ItemsSource="{Binding DegreeNames}" SelectedIndex="{Binding DegreeIndex, Mode=TwoWay}"/>
            <TextBlock Style="{StaticResource Lbl}" Text="{loc:Tr 'FondamentaleNote'}"/>
            <ComboBox Style="{StaticResource Cb}" ItemsSource="{Binding RootNames}" SelectedIndex="{Binding RootIndex, Mode=TwoWay}" IsEnabled="{Binding RootEnabled}"/>
            <TextBlock Style="{StaticResource Lbl}" Text="{loc:Tr 'Couleur'}"/>
            <ComboBox Style="{StaticResource Cb}" ItemsSource="{Binding ColourNames}" SelectedIndex="{Binding ColourIndex, Mode=TwoWay}"/>
            <TextBlock Style="{StaticResource Lbl}" Text="{loc:Tr 'SuspenduCouleurSecondaire'}"/>
            <ComboBox Style="{StaticResource Cb}" ItemsSource="{Binding SuspensionNames}" SelectedIndex="{Binding SuspensionIndex, Mode=TwoWay}"/>
            <TextBlock Style="{StaticResource Lbl}" Text="{loc:Tr 'MajeurMineurForcer'}"/>
            <ComboBox Style="{StaticResource Cb}" ItemsSource="{Binding ModeNames}" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"/>

            <TextBlock Style="{StaticResource Lbl}" Text="{loc:Tr 'NombreDeTemps'}"/>
            <TextBox Style="{StaticResource Num}" Text="{Binding Beats, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

            <!-- INTENTION DE VOICING portée par l'accord : elle ne sonne pas ici (la lane est muette) mais les
                 modules qui l'articulent peuvent s'y référer via leur option « selon l'accord ». -->
            <CheckBox Style="{StaticResource Chk}" Content="{loc:Tr 'VoicingOuvertEcarte'}" IsChecked="{Binding OpenVoicing, Mode=TwoWay}"/>
            <TextBlock Style="{StaticResource Lbl}" Text="{loc:Tr 'RenversementAutoVoiceLeading'}"/>
            <ComboBox Style="{StaticResource Cb}" ItemsSource="{Binding VoiceLeadNames}" SelectedIndex="{Binding VoiceLeadIndex, Mode=TwoWay}"/>
            <StackPanel Visibility="{Binding FixedInversionVisibility}">
                <TextBlock Style="{StaticResource Lbl}" Text="{loc:Tr 'Renversement0Fondamental'}"/>
                <TextBox Style="{StaticResource Num}" Text="{Binding Inversion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>

            <TextBlock Foreground="#888888" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="210"
                       Text="{loc:Tr 'AccordHarmonieSeuleTip'}"/>
        </StackPanel>
    </ScrollViewer>

        <!-- LE CO-PILOTE, directement dans l'éditeur (plus de dialogue) : les suites classées de CET accord, en
             cartes. Clic = l'accord est inséré juste après ; clic droit = cet accord le devient ; survol = écoute. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,0,8,0">
                <!-- L'accord TEL QU'IL EST VOICÉ (renversement et octave choisis par la conduite des voix, voicing
                     ouvert), et à droite sa vignette : nom, degré coloré par fonction, fonction. -->
                <TextBlock Text="{loc:Tr 'AccordAuClavier'}" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="0,4,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <local:ChordKeyboard Width="420" Height="76" Notes="{Binding KeyboardNotes}" LitBrush="{Binding FunctionBrush}"/>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding ChordTitle}" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Border MinWidth="56" Height="26" CornerRadius="5" Padding="8,0" Background="{Binding FunctionBrush}">
                                <TextBlock Text="{Binding ChordRoman}" Foreground="White" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding FunctionName}" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{loc:Tr 'SuggererLAccordSuivant'}" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="0,4,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr 'Humeur'}" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="130" ItemsSource="{Binding MoodNames}" SelectedIndex="{Binding MoodIndex, Mode=TwoWay}"/>
                    <Button Content="{loc:Tr 'Enchainer4Mesures'}" Command="{Binding ChainCommand}" Margin="10,0,0,0" Padding="12,3" Cursor="Hand"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="164" Height="52" Margin="0,0,8,8" CornerRadius="6" Cursor="Hand"
                                    BorderBrush="{Binding Border}" BorderThickness="{Binding BorderThickness}"
                                    MouseLeftButtonUp="Card_Pick" MouseRightButtonUp="Card_Replace"
                                    MouseEnter="Card_Enter" MouseLeave="Card_Leave">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#2A2A33"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3A3A46"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="44" Margin="5" CornerRadius="5" Background="{Binding Fill}">
                                        <TextBlock Text="{Binding Roman}" Foreground="White" FontWeight="Bold" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="3,0,6,0">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Effect}" Foreground="#AAAAAA" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:Tr 'CetAccordNEstPasSur'}" Visibility="{Binding NoSuggestionVisibility}"
                           Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{loc:Tr 'SuggestionCartesAide'}" Foreground="#888888" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
