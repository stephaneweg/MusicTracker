<Application x:Class="MusicTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MusicTracker"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Tout le contenu vit dans Theme/AppResources.xaml pour être partagé avec KotonLive.exe
                 (cf. l'en-tête de ce fichier). Ne rien ajouter ICI : une ressource déclarée seulement
                 dans App.xaml manquerait à l'application live. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/AppResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
