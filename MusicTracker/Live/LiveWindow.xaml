<Window x:Class="MusicTracker.Live.LiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:MusicTracker.Controls"
        xmlns:loc="clr-namespace:MusicTracker.Localization"
        mc:Ignorable="d" Foreground="{StaticResource CommonForeground}"
        Title="{loc:Tr 'LiveTitle'}" Width="620" Height="700" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <!-- Style des sections : un titre teal + un cadre discret, plutôt qu'un GroupBox (dont le header
             réserve une place fixe qui déséquilibre des blocs de hauteurs très différentes). -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1FB6C3"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="#2A2C33"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#80868E"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="20,0,0,4"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CommonBackground}" BorderBrush="{StaticResource OutlineColorBrush}" BorderThickness="3" CornerRadius="8">
        <DockPanel>
            <!-- Barre de titre déplaçable (fenêtre sans chrome système, comme le reste de la suite). -->
            <Border DockPanel.Dock="Top" ctrl:WindowDrag.Enable="True" CornerRadius="6,6,0,0" Padding="16,10,10,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Name="btnMinimize" Content="—" Style="{StaticResource TinyButton}" Width="26" Height="20" ToolTip="{loc:Tr 'Minimize'}" Click="Minimize_Click"/>
                        <Button Name="btnClose" Content="✕" Style="{StaticResource TinyButton}" Width="26" Height="20" Margin="4,0,0,0" ToolTip="{loc:Tr 'Close'}" Click="Close_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr 'LiveTitle'}" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="{loc:Tr 'LiveSubtitle'}" Foreground="#80868E" FontSize="10"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Barre d'état : ce que fait le moteur, à quelle fréquence, avec quelle latence. -->
            <Border DockPanel.Dock="Bottom" Background="#212328" CornerRadius="0,0,6,6" Padding="16,6">
                <DockPanel>
                    <TextBlock Name="lblUnderruns" DockPanel.Dock="Right" Foreground="#C0703B" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Name="lblStatus" Foreground="#9AA0A8" FontSize="10" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,16,8">
                <StackPanel>

                    <!-- ==================== Mode ==================== -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr 'LiveModeSection'}" Style="{StaticResource SectionTitle}"/>
                            <RadioButton Name="rbInsert" GroupName="mode" Content="{loc:Tr 'LiveModeInsert'}" IsChecked="True" Checked="Mode_Changed"/>
                            <TextBlock Text="{loc:Tr 'LiveModeInsertHint'}" Style="{StaticResource Hint}"/>
                            <RadioButton Name="rbInstrument" GroupName="mode" Content="{loc:Tr 'LiveModeInstrument'}" Margin="0,4,0,0" Checked="Mode_Changed"/>
                            <TextBlock Text="{loc:Tr 'LiveModeInstrumentHint'}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== Audio ==================== -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr 'LiveAudioSection'}" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr 'LiveBackend'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Name="cboBackend" Margin="0,2" SelectionChanged="Backend_Changed"/>
                                <Button Grid.Row="0" Grid.Column="2" Name="btnAsioPanel" Content="{loc:Tr 'LiveAsioPanel'}" Style="{StaticResource TinyButton}" Margin="6,2,0,2" Click="AsioPanel_Click"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Name="lblInput" Text="{loc:Tr 'LiveInput'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Name="cboInput" Margin="0,2"/>
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Name="pnlAsioChannel" Margin="6,2,0,2">
                                    <TextBlock Text="{loc:Tr 'LiveAsioChannel'}" Style="{StaticResource FieldLabel}" Margin="0,0,4,0"/>
                                    <ComboBox Name="cboAsioChannel" Width="52"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Name="lblOutput" Text="{loc:Tr 'LiveOutput'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Name="cboOutput" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Name="lblLatency" Text="{loc:Tr 'LiveLatency'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" Name="cboLatency" Margin="0,2" HorizontalAlignment="Left" Width="110"/>
                            </Grid>

                            <!-- Vu-mètres + transport. -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr 'LiveInputLevel'}" Style="{StaticResource FieldLabel}"/>
                                <Border Grid.Row="0" Grid.Column="1" Background="#15161A" CornerRadius="2" Height="10" Margin="0,2">
                                    <Rectangle Name="meterIn" Fill="#1FB6C3" HorizontalAlignment="Left" Width="0" RadiusX="2" RadiusY="2"/>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr 'LiveOutputLevel'}" Style="{StaticResource FieldLabel}"/>
                                <Border Grid.Row="1" Grid.Column="1" Background="#15161A" CornerRadius="2" Height="10" Margin="0,2">
                                    <Rectangle Name="meterOut" Fill="#3BCEDA" HorizontalAlignment="Left" Width="0" RadiusX="2" RadiusY="2"/>
                                </Border>
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Name="btnStart" Content="{loc:Tr 'LiveStart'}"
                                        Style="{StaticResource okButton}" Padding="16,4" Margin="10,0,0,0" Cursor="Hand" Click="StartStop_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ==================== Instrument (mode instrument) ==================== -->
                    <Border Style="{StaticResource Section}" Name="pnlInstrument">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr 'LiveInstrumentSection'}" Style="{StaticResource SectionTitle}"/>

                            <DockPanel>
                                <!-- Transposition appliquée aux notes reçues, quelle que soit la source :
                                     chanter dans son registre et faire jouer l'instrument dans un autre. -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="{loc:Tr 'LiveOctave'}" Style="{StaticResource FieldLabel}" Margin="12,0,6,0"/>
                                    <ComboBox Name="cboOctave" Width="58" SelectionChanged="Detection_Changed"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Tr 'LiveNoteSource'}" Style="{StaticResource FieldLabel}"/>
                                    <RadioButton Name="rbMidi" GroupName="src" Content="{loc:Tr 'LiveNoteSourceMidi'}" IsChecked="True" Margin="0,0,12,0" Checked="NoteSource_Changed"/>
                                    <RadioButton Name="rbMic" GroupName="src" Content="{loc:Tr 'LiveNoteSourceMic'}" Checked="NoteSource_Changed"/>
                                </StackPanel>
                            </DockPanel>

                            <ComboBox Name="cboMidiDevice" Margin="0,6,0,0" SelectionChanged="MidiDevice_Changed"/>

                            <!-- Réglages propres à la détection de hauteur au micro. -->
                            <StackPanel Name="pnlMic" Margin="0,6,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{loc:Tr 'LiveDetectionMic'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Name="cboMicDevice" SelectionChanged="MicDevice_Changed"/>
                                </DockPanel>
                                <!-- Retour visuel de la DÉTECTION (pas du moteur) : niveau capté, seuil de
                                     voisement, et dernière note reconnue. C'est ce qui permet de distinguer
                                     « micro trop faible » de « mauvais périphérique » de « ça marche ». -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Tr 'LiveDetected'}" Style="{StaticResource FieldLabel}"/>
                                    <Border Grid.Column="1" Background="#15161A" CornerRadius="2" Height="10" VerticalAlignment="Center">
                                        <Grid>
                                            <Rectangle Name="meterMic" Fill="#1FB6C3" HorizontalAlignment="Left" Width="0" RadiusX="2" RadiusY="2"/>
                                            <!-- Repère du seuil en dessous duquel rien n'est détecté. -->
                                            <Rectangle Name="micThreshold" Fill="#C0703B" Width="1" HorizontalAlignment="Left" Margin="0"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="2" Name="lblDetected" MinWidth="52" TextAlignment="Right"
                                               Foreground="#3BCEDA" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr 'LiveScale'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" Name="cboScale" Margin="0,2,8,2" SelectionChanged="Detection_Changed"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Tr 'LiveRoot'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="3" Name="cboRoot" Margin="0,2" SelectionChanged="Detection_Changed"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr 'LiveOnsetSensitivity'}" Style="{StaticResource FieldLabel}"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Name="sldOnset" Minimum="0" Maximum="1" Value="0.5" Margin="0,2,8,2" ValueChanged="Detection_Changed"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Tr 'LiveVelocity'}" Style="{StaticResource FieldLabel}"/>
                                    <Slider Grid.Row="1" Grid.Column="3" Name="sldVelocity" Minimum="1" Maximum="127" Value="100" Margin="0,2" ValueChanged="Detection_Changed"/>
                                    <!-- Seuil de voisement : le repère orange du vumètre de détection suit ce
                                         curseur, donc on règle en regardant si sa voix passe au-dessus. -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr 'LiveThreshold'}" Style="{StaticResource FieldLabel}"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Name="sldThreshold" Minimum="0.001" Maximum="0.06"
                                            Value="0.012" Margin="0,2,8,2" ValueChanged="Threshold_Changed"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Name="lblThreshold" Style="{StaticResource FieldLabel}" Margin="0,2"/>
                                    <!-- Durée minimale : un changement qui ne tient pas ce temps est ignoré
                                         sans le moindre événement, la note en cours continue. -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr 'LiveMinDuration'}" Style="{StaticResource FieldLabel}"/>
                                    <Slider Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Name="sldMinDuration" Minimum="0" Maximum="0.2"
                                            Value="0.055" Margin="0,2,8,2" ValueChanged="MinDuration_Changed"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Name="lblMinDuration" Style="{StaticResource FieldLabel}" Margin="0,2"/>
                                    <!-- Écart max : au-delà, l'analyse s'est trompée d'octave — trame ignorée. -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr 'LiveMaxLeap'}" Style="{StaticResource FieldLabel}"/>
                                    <Slider Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Name="sldMaxLeap" Minimum="12" Maximum="36"
                                            Value="24" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,8,2" ValueChanged="MaxLeap_Changed"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Name="lblMaxLeap" Style="{StaticResource FieldLabel}" Margin="0,2"/>
                                    <!-- Justesse : médiane sur la hauteur continue avant arrondi, et largeur
                                         de la fenêtre d'analyse (plus large = plus sûr dans le grave). -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Tr 'LiveSmoothing'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" Name="cboSmoothing" Margin="0,2,8,2" SelectionChanged="Smoothing_Changed"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{loc:Tr 'LiveAnalysisWindow'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Row="5" Grid.Column="3" Name="cboFrameSize" Margin="0,2" SelectionChanged="FrameSize_Changed"/>
                                    <!-- Accroche : marge en cents avant de lâcher la note tenue. -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Tr 'LiveSnap'}" Style="{StaticResource FieldLabel}"/>
                                    <Slider Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Name="sldSnap" Minimum="0" Maximum="50"
                                            Value="20" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,8,2" ValueChanged="Snap_Changed"/>
                                    <TextBlock Grid.Row="6" Grid.Column="3" Name="lblSnap" Style="{StaticResource FieldLabel}" Margin="0,2"/>
                                    <!-- Plage de recherche : la note la plus grave de l'instrument ferme la
                                         porte aux erreurs d'octave basse, qui consistent a verrouiller sur la
                                         periode double. L'anti-octave est le second levier, sur le seuil MPM. -->
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Tr 'LiveLowestNote'}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Row="7" Grid.Column="1" Name="cboLowestNote" Margin="0,2,8,2" SelectionChanged="Detection_Changed"/>
                                    <TextBlock Grid.Row="7" Grid.Column="2" Text="{loc:Tr 'LiveOctaveBias'}" Style="{StaticResource FieldLabel}"/>
                                    <Slider Grid.Row="7" Grid.Column="3" Name="sldOctaveBias" Minimum="0" Maximum="1" Value="0" Margin="0,2" ValueChanged="OctaveBias_Changed"/>
                                </Grid>
                                <CheckBox Name="chkMonitor" Content="{loc:Tr 'LiveMonitorInput'}" Margin="0,4,0,0" Checked="Monitor_Changed" Unchecked="Monitor_Changed"/>
                            </StackPanel>

                            <!-- Choix de la source sonore. -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Tr 'LiveInstrumentKind'}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Column="1" Name="cboInstrumentKind" Width="120" Margin="0,2,8,2" SelectionChanged="InstrumentKind_Changed"/>
                                <ComboBox Grid.Column="2" Name="cboProgram" Margin="0,2" SelectionChanged="Program_Changed"/>
                                <Button Grid.Column="2" Name="btnPickPlugin" Content="{loc:Tr 'LiveChoose'}" Style="{StaticResource TinyButton}" HorizontalAlignment="Stretch" Margin="0,2" Click="PickPlugin_Click"/>
                                <Button Grid.Column="3" Name="btnEditInstrument" Content="{loc:Tr 'LiveEditInstrument'}" Style="{StaticResource TinyButton}" Margin="6,2,0,2" Click="EditInstrument_Click"/>
                            </Grid>
                            <TextBlock Name="lblInstrument" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== Effets ==================== -->
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Name="btnResetFx" Content="{loc:Tr 'LiveResetEffects'}" Style="{StaticResource TinyButton}" Click="ResetFx_Click"/>
                                <TextBlock Text="{loc:Tr 'LiveEffectsSection'}" Style="{StaticResource SectionTitle}"/>
                            </DockPanel>
                            <ContentControl Name="insertsHost"/>
                        </StackPanel>
                    </Border>

                    <!-- ==================== Sortie ==================== -->
                    <Border Style="{StaticResource Section}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Tr 'LiveInputGain'}" Style="{StaticResource FieldLabel}"/>
                            <Slider Grid.Column="1" Name="sldInGain" Minimum="0" Maximum="4" Value="1" Margin="0,0,8,0" ValueChanged="Gain_Changed"/>
                            <TextBlock Grid.Column="2" Text="{loc:Tr 'LiveOutputGain'}" Style="{StaticResource FieldLabel}"/>
                            <Slider Grid.Column="3" Name="sldOutGain" Minimum="0" Maximum="2" Value="0.85" Margin="0,0,8,0" ValueChanged="Gain_Changed"/>
                            <Button Grid.Column="4" Name="btnPanic" Content="{loc:Tr 'LivePanic'}" Style="{StaticResource TinyButton}" Click="Panic_Click"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
