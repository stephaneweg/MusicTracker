<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MusicTracker</RootNamespace>
    <!-- Shipped binary is KotonStudio.exe (brand). RootNamespace stays MusicTracker (internal identity). -->
    <AssemblyName>KotonStudio</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ProjectGuid>{9B3F5D8F-6385-4132-8EEE-641BA8E68498}</ProjectGuid>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <!-- Preserve legacy output layout (bin\Release\KotonStudio.exe, no TFM/RID subfolders) so
         installer\MusicTracker.iss and installer\release.ps1 keep working unchanged. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Keep the hand-maintained Properties/AssemblyInfo.cs (title, version bumped by release.ps1). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CA1416: the app is Windows-only by design (net{8,10}.0-windows); registry / WPF / Win32
         call sites are always reachable on Windows.
         NU1510: on net10 a few of our explicit PackageReferences (System.Text.Json,
         System.Configuration.ConfigurationManager) are in-box; kept referenced for symmetry with
         a net8 downgrade branch.
         SYSLIB0014: legacy ServicePointManager.SecurityProtocol nudge in SoundFontDownloader and
         UpdateChecker enables TLS 1.2 on legacy targets and is a no-op on modern .NET. -->
    <NoWarn>$(NoWarn);CA1416;NU1510;SYSLIB0011;SYSLIB0014;SYSLIB0051</NoWarn>
  </PropertyGroup>

  <!-- ================= NuGet packages =================
       Trimmed vs. the legacy packages.config: all System.* utility packages (Buffers, Memory,
       Numerics.Vectors, ValueTuple, IO.Pipelines, Runtime.CompilerServices.Unsafe,
       Threading.Tasks.Extensions, Security.AccessControl, Security.Principal.Windows,
       Bcl.AsyncInterfaces) are IN-BOX in net10.0-windows and removed. Microsoft.Win32.Registry is
       in-box on the Windows target. Unnoficial.Microsoft.Expression.Drawing and WriteableBitmapEx
       were referenced but nowhere used in code, dropped. NAudio.WinForms provides NAudio.Gui.*
       (unused), dropped. -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <!-- App.config appSettings lookup (ChangelogUrl, GitHubRepo, GitHubReleasesRepo) via
         System.Configuration.ConfigurationManager, which is a package on .NET Core+ instead of
         being in the BCL like on .NET Framework. -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeltySynth\MeltySynth.csproj" />
  </ItemGroup>

  <!-- ================= Non-code items =================
       The SDK auto-globs *.cs and *.xaml. Everything else (data JSON, fonts, icons, images,
       language tables) still needs an explicit entry so it's copied next to the exe. -->
  <ItemGroup>
    <!-- Bravura music font: EMBEDDED into the assembly as a WPF Resource (loaded via pack URI). -->
    <Resource Include="Fonts\Bravura.otf" />
    <!-- Bravura companion metadata JSON: SHIPS next to the font under Fonts\ (loaded from disk). -->
    <Content Include="Fonts\bravura_metadata.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- WPF resources embedded in the assembly. -->
    <Resource Include="gridbg.png" />
    <Resource Include="Images\logo-mark.png" />

    <!-- app.ico is embedded via <ApplicationIcon>; document.ico ships next to the exe and is
         referenced by the .sq file association (FileAssociations.cs). -->
    <Content Include="document.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- All Data\**\*.json (drums catalog, templates, catalogue, themes, corpus models) are read
         from disk relative to the exe. -->
    <Content Include="Data\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- Language tables ship as loose files next to the exe (Localization\lang.<code>.json), NOT
         embedded, so a new translation can be dropped in the install folder and picked up at next
         launch with no rebuild. -->
    <Content Include="Localization\lang.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- SoundFonts (SoundFont\*.sf2) are intentionally NOT referenced here and NOT
         version-controlled: they are third-party binary assets of several hundred MB, over
         GitHub's 100 MB per-file limit. Excluded by .gitignore, downloaded on first launch by
         SoundFontDownloader (see AppPaths.Local). -->
  </ItemGroup>

  <!-- App.config with appSettings; supported on .NET Core+ via
       System.Configuration.ConfigurationManager. -->
  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>

  <!-- ================= GitHub token injection (build-time secret) =================
       Reads the GitHub token, in priority order, from: the gitignored releases\releases.token file
       (in the nested MusicTracker_Releases checkout — a fine-grained PAT with Issues:read/write on
       MusicTracker for the bug reporter AND Contents:read on MusicTracker_Releases for the update
       check), then the MUSICTRACKER_GH_TOKEN env var. Generates BuildSecrets.g.cs into obj\
       holding it XOR-scrambled + base64. The token is NEVER committed; a build without one yields
       an empty constant (bug reporter + update check then report as "not configured").
       The XOR key below MUST stay in sync with MusicTracker.Engine.BugReport.BugReportConfig.XorKey.
       Modern MSBuild (SDK-style project) requires RoslynCodeTaskFactory instead of the legacy
       CodeTaskFactory. -->
  <UsingTask TaskName="GenerateBuildSecrets"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ReleaseTokenFile ParameterType="System.String" Required="false" />
      <EnvToken ParameterType="System.String" Required="false" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
          string raw = "";
          // Priority: releases/releases.token (fine-grained PAT: Issues:r/w on MusicTracker + Contents:read on
          // MusicTracker_Releases; used by both the bug reporter and the update check) → MUSICTRACKER_GH_TOKEN env var.
          if (!string.IsNullOrEmpty(ReleaseTokenFile) && System.IO.File.Exists(ReleaseTokenFile))
              raw = System.IO.File.ReadAllText(ReleaseTokenFile).Trim();
          if (string.IsNullOrEmpty(raw) && !string.IsNullOrEmpty(EnvToken))
              raw = EnvToken.Trim();
          string enc = "";
          if (!string.IsNullOrEmpty(raw)) {
              byte[] key = System.Text.Encoding.UTF8.GetBytes("MusicTracker-BugReport-XOR-v1");
              byte[] data = System.Text.Encoding.UTF8.GetBytes(raw);
              for (int i = 0; i < data.Length; i++) data[i] ^= key[i % key.Length];
              enc = System.Convert.ToBase64String(data);
          }
          var sb = new System.Text.StringBuilder();
          sb.AppendLine("// <auto-generated> Build-time injected secret. DO NOT COMMIT. Regenerated on every build. </auto-generated>");
          sb.AppendLine("namespace MusicTracker {");
          sb.AppendLine("    internal static class BuildSecrets {");
          sb.AppendLine("        public const string GitHubIssueTokenXorB64 = \"" + enc + "\";");
          sb.AppendLine("    }");
          sb.AppendLine("}");
          string next = sb.ToString();
          string prev = System.IO.File.Exists(OutputFile) ? System.IO.File.ReadAllText(OutputFile) : null;
          if (prev != next) System.IO.File.WriteAllText(OutputFile, next);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateBuildSecrets" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <GenerateBuildSecrets ReleaseTokenFile="$(ProjectDir)..\releases\releases.token"
                          EnvToken="$(MUSICTRACKER_GH_TOKEN)"
                          OutputFile="$(IntermediateOutputPath)BuildSecrets.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildSecrets.g.cs" />
    </ItemGroup>
  </Target>

</Project>
