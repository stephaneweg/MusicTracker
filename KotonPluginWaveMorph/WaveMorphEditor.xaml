<UserControl x:Class="KotonPluginWaveMorph.WaveMorphEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#16161c"
             Foreground="#DDDDDD"
             FontFamily="Segoe UI"
             MinWidth="900" MinHeight="640">
    <!--
    Editeur du Wave Morph. Couleurs hardcodees (un plugin Koton est un assembly independant, pas
    d'acces aux ressources de l'hote). Palette Koton :
      #16161c fond page, #22222a panel, #2c2c36 panel-hi, #35353f border, #1FB6C3 teal accent,
      #0F7A88 teal dim, #DDDDDD texte, #888 texte dim.

    Layout global (4 bandes empilees) :
      1. Wave morph (X-Fade + W1/Result/W2)
      2. 3 enveloppes + 2 LFO (5 colonnes)
      3. Mod matrix + Filtres + Output
      4. Onde finale (scope live large)
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Ground"    Color="#16161c"/>
        <SolidColorBrush x:Key="Panel"     Color="#22222a"/>
        <SolidColorBrush x:Key="PanelHi"   Color="#2c2c36"/>
        <SolidColorBrush x:Key="Border"    Color="#35353f"/>
        <SolidColorBrush x:Key="BorderHi"  Color="#4a4a55"/>
        <SolidColorBrush x:Key="Accent"    Color="#1FB6C3"/>
        <SolidColorBrush x:Key="AccentDim" Color="#0F7A88"/>
        <SolidColorBrush x:Key="Text"      Color="#DDDDDD"/>
        <SolidColorBrush x:Key="TextDim"   Color="#888888"/>
        <SolidColorBrush x:Key="TextLo"    Color="#5c5c66"/>

        <!-- Slider horizontal minimal (out/panels) : rail fin teal, thumb rectangle -->
        <Style x:Key="KotonHSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#333340"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Titre de section : 11 uppercase spaced -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>

        <!-- Sous-titre discret aligne a droite -->
        <Style x:Key="SectionSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextLo}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- Cellule K/V (label + valeur mono teal) sous les enveloppes / LFOs -->
        <Style x:Key="KvCell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelHi}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>

        <!-- Bouton toggle segment (Serial/Parallel, Mono/Poly8/Poly16) -->
        <Style x:Key="SegToggle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelHi}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="brd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="brd" Property="BorderBrush" Value="{StaticResource BorderHi}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox theme : fond panel-hi, teal accent sur focus -->
        <Style x:Key="KotonCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelHi}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="14">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Bandeau titre -->
                <RowDefinition Height="Auto"/> <!-- Bande 1 : Wave morph -->
                <RowDefinition Height="Auto"/> <!-- Bande 2 : envs + LFOs -->
                <RowDefinition Height="Auto"/> <!-- Bande 3 : matrix + filters + output -->
                <RowDefinition Height="Auto"/> <!-- Bande 4 : onde finale -->
            </Grid.RowDefinitions>

            <!-- =============== Bandeau titre =============== -->
            <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="3,3,0,0" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="WAVE MORPH" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="2-oscillator morphing synth" Margin="16,0,0,0"
                               Style="{StaticResource SectionSub}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- =============== BANDE 1 : Wave morph =============== -->
            <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1,0,1,1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="WAVE MORPH" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="440 Hz - 2 cycles affiches" Style="{StaticResource SectionSub}"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Slider XFade vertical -->
                        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="W2" Style="{StaticResource SectionSub}" HorizontalAlignment="Center"/>
                            <TextBlock Text="1.0" Style="{StaticResource SectionSub}" HorizontalAlignment="Center"/>
                            <Slider x:Name="XFadeSlider" Orientation="Vertical" Height="260"
                                    Minimum="0" Maximum="1" Value="0.5" HorizontalAlignment="Center"
                                    Foreground="{StaticResource Accent}" IsMoveToPointEnabled="True"
                                    Margin="0,4"/>
                            <TextBlock Text="0.0" Style="{StaticResource SectionSub}" HorizontalAlignment="Center"/>
                            <TextBlock Text="W1" Style="{StaticResource SectionSub}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="XFadeValue" Text="0.50" Foreground="{StaticResource Accent}"
                                       FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="X-FADE" Style="{StaticResource SectionSub}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 3 vues empilees -->
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="1.4*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Wave 2 (haut) -->
                            <Border Grid.Row="0" x:Name="Wave2Panel" Background="#14141a"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    CornerRadius="2" Margin="0,0,0,4">
                                <Grid>
                                    <ContentPresenter x:Name="Wave2Host" Margin="4"/>
                                    <Border Background="#80000000" CornerRadius="2" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                        <TextBlock x:Name="Wave2Badge" Text="Wave 2" FontSize="10"
                                                   Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                    <StackPanel x:Name="Wave2Picker" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,6,6,0" Background="#80000000"/>
                                    <Border Background="#80000000" CornerRadius="2" Padding="6,2"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Amp " Foreground="{StaticResource TextDim}" FontSize="10"/>
                                            <TextBlock x:Name="Wave2AmpText" Text="-6 dB"
                                                       Foreground="{StaticResource Text}" FontSize="10" FontFamily="Consolas"/>
                                            <TextBlock Text=" . Det " Foreground="{StaticResource TextDim}" FontSize="10"/>
                                            <TextBlock x:Name="Wave2DetText" Text="0 ct"
                                                       Foreground="{StaticResource Text}" FontSize="10" FontFamily="Consolas"/>
                                            <TextBlock Text=" . Mult " Foreground="{StaticResource TextDim}" FontSize="10"/>
                                            <TextBlock x:Name="Wave2MultText" Text="x1"
                                                       Foreground="{StaticResource Text}" FontSize="10" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Wave RESULTAT (milieu, teal) -->
                            <Border Grid.Row="1" x:Name="ResultPanel" Background="#14141a"
                                    BorderBrush="{StaticResource AccentDim}" BorderThickness="1"
                                    CornerRadius="2" Margin="0,4">
                                <Grid>
                                    <ContentPresenter x:Name="ResultHost" Margin="4"/>
                                    <Border Background="#80000000" BorderBrush="{StaticResource AccentDim}"
                                            BorderThickness="1" CornerRadius="2" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                        <TextBlock x:Name="ResultBadge" Text="Resultat . lerp(W1, W2, 0.50)"
                                                   FontSize="10" Foreground="{StaticResource Accent}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Wave 1 (bas) -->
                            <Border Grid.Row="2" x:Name="Wave1Panel" Background="#14141a"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    CornerRadius="2" Margin="0,4,0,0">
                                <Grid>
                                    <ContentPresenter x:Name="Wave1Host" Margin="4"/>
                                    <Border Background="#80000000" CornerRadius="2" Padding="6,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                        <TextBlock x:Name="Wave1Badge" Text="Wave 1" FontSize="10"
                                                   Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                    <StackPanel x:Name="Wave1Picker" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,6,6,0" Background="#80000000"/>
                                    <Border Background="#80000000" CornerRadius="2" Padding="6,2"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Amp " Foreground="{StaticResource TextDim}" FontSize="10"/>
                                            <TextBlock x:Name="Wave1AmpText" Text="-6 dB"
                                                       Foreground="{StaticResource Text}" FontSize="10" FontFamily="Consolas"/>
                                            <TextBlock Text=" . Det " Foreground="{StaticResource TextDim}" FontSize="10"/>
                                            <TextBlock x:Name="Wave1DetText" Text="0 ct"
                                                       Foreground="{StaticResource Text}" FontSize="10" FontFamily="Consolas"/>
                                            <TextBlock Text=" . Mult " Foreground="{StaticResource TextDim}" FontSize="10"/>
                                            <TextBlock x:Name="Wave1MultText" Text="x1"
                                                       Foreground="{StaticResource Text}" FontSize="10" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- =============== BANDE 2 : 3 envs + 2 LFOs =============== -->
            <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1,0,1,1" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Env Amp -->
                    <StackPanel Grid.Column="0" Margin="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AMP" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="→ Voix" Style="{StaticResource SectionSub}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="EnvAmpHost" Background="#14141a" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="2" Height="90" Margin="0,6,0,6"/>
                        <UniformGrid x:Name="EnvAmpKvGrid" Columns="4" Height="30"/>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Fill="{StaticResource Border}"/>

                    <!-- Env 2 -->
                    <StackPanel Grid.Column="2" Margin="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ENV 2" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="→ Mod matrix" Style="{StaticResource SectionSub}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="Env2Host" Background="#14141a" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="2" Height="90" Margin="0,6,0,6"/>
                        <UniformGrid x:Name="Env2KvGrid" Columns="4" Height="30"/>
                    </StackPanel>
                    <Rectangle Grid.Column="3" Fill="{StaticResource Border}"/>

                    <!-- Env 3 -->
                    <StackPanel Grid.Column="4" Margin="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ENV 3" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="→ Mod matrix" Style="{StaticResource SectionSub}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="Env3Host" Background="#14141a" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="2" Height="90" Margin="0,6,0,6"/>
                        <UniformGrid x:Name="Env3KvGrid" Columns="4" Height="30"/>
                    </StackPanel>
                    <Rectangle Grid.Column="5" Fill="{StaticResource Border}"/>

                    <!-- LFO 1 -->
                    <StackPanel Grid.Column="6" Margin="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LFO 1" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="Lfo1SubTitle" Text="Sine" Style="{StaticResource SectionSub}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="Lfo1Host" Background="#14141a" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="2" Height="90" Margin="0,6,0,6"/>
                        <UniformGrid x:Name="Lfo1KvGrid" Columns="3" Height="30"/>
                    </StackPanel>
                    <Rectangle Grid.Column="7" Fill="{StaticResource Border}"/>

                    <!-- LFO 2 -->
                    <StackPanel Grid.Column="8" Margin="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LFO 2" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="Lfo2SubTitle" Text="Triangle" Style="{StaticResource SectionSub}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="Lfo2Host" Background="#14141a" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="2" Height="90" Margin="0,6,0,6"/>
                        <UniformGrid x:Name="Lfo2KvGrid" Columns="3" Height="30"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =============== BANDE 3 : mod matrix + filters + output =============== -->
            <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1,0,1,1" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mod matrix -->
                    <StackPanel Grid.Column="0" Margin="12">
                        <TextBlock Text="MODULATION" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <Border Background="#14141a" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="2" Padding="6">
                            <Grid x:Name="ModMatrixGrid"/>
                        </Border>
                        <TextBlock Text="Clic sur une case pour cycler amount : 0, +50, +100, -50, -100, 0"
                                   Style="{StaticResource SectionSub}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Fill="{StaticResource Border}"/>

                    <!-- Filters -->
                    <StackPanel Grid.Column="2" Margin="12">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="FILTERS" Style="{StaticResource SectionTitle}"
                                       HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RoutingSerialBtn"   Content="Serie"    Style="{StaticResource SegToggle}"/>
                                <Button x:Name="RoutingParallelBtn" Content="Parallele" Style="{StaticResource SegToggle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Filter 1 -->
                            <Border Grid.Column="0" Background="#14141a" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="2" Padding="8">
                                <StackPanel x:Name="Filter1Panel"/>
                            </Border>
                            <!-- Filter 2 -->
                            <Border Grid.Column="2" Background="#14141a" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="2" Padding="8">
                                <StackPanel x:Name="Filter2Panel"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <Rectangle Grid.Column="3" Fill="{StaticResource Border}"/>

                    <!-- Output -->
                    <StackPanel Grid.Column="4" Margin="12">
                        <TextBlock Text="OUTPUT" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <StackPanel x:Name="OutputPanel"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =============== BANDE 4 : Onde finale =============== -->
            <Border Grid.Row="4" Background="#14141a" BorderBrush="{StaticResource Border}"
                    BorderThickness="1,0,1,1" Padding="14"
                    CornerRadius="0,0,3,3">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ONDE FINALE (sortie live)"
                                       Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text="morph x amp env x filtres - post-processing complet"
                                       Style="{StaticResource SectionSub}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="RMS " Foreground="{StaticResource TextDim}" FontSize="10"/>
                            <TextBlock x:Name="ScopeRms" Text="-inf" Foreground="{StaticResource Accent}"
                                       FontFamily="Consolas" FontSize="10" MinWidth="50"/>
                            <TextBlock Text=" . Peak " Foreground="{StaticResource TextDim}" FontSize="10" Margin="8,0,0,0"/>
                            <TextBlock x:Name="ScopePeak" Text="-inf" Foreground="{StaticResource Accent}"
                                       FontFamily="Consolas" FontSize="10" MinWidth="50"/>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="FinalScopeHost" Background="#08080c" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="2" Height="90"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
