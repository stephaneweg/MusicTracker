    <ProjectGuid>{B7E3D5A2-9F8C-4D1E-8A5B-3F2E4D6C7A81}</ProjectGuid>
    <Deterministic>true</Deterministic>
    <!-- Installer ships this next to KotonStudio.exe in the app root — no TFM subfolder. -->
