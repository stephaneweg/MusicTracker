<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MeltySynth</RootNamespace>
    <AssemblyName>MeltySynth</AssemblyName>
    <ProjectGuid>{6F3A1C2B-9D4E-4F8A-B1C7-2E5D9A0F3B41}</ProjectGuid>
    <!-- Official MeltySynth source uses C# 8+ nullable annotations; enable the annotation context
         (annotations only, no null-flow warnings) so `T?` compiles. -->
    <Nullable>annotations</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- The MeltySynth vendored source triggers CS8632 (nullable annotations without #nullable enable) and a
         few default-literal warnings on the .NET 8 compiler. They are cosmetic in this net48-lifted library;
         silence them project-wide so the build stays green without touching the vendored code. -->
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

</Project>
