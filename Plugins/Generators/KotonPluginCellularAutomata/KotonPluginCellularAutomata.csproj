<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KotonPluginCellularAutomata</RootNamespace>
    <AssemblyName>KotonPluginCellularAutomata</AssemblyName>
    <ProjectGuid>{E6F7A8B9-1234-4A0B-8C1D-9E0F1A2B3C9C}</ProjectGuid>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TargetExt>.ksl</TargetExt>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\..\..\KotonStudioLibrary\KotonStudioLibrary.csproj" /></ItemGroup>
  <Target Name="CopyKslToHostBinPluginsDir" AfterTargets="Build">
    <PropertyGroup>
      <KslArtifact>$(TargetPath)</KslArtifact>
      <HostBinPluginsDir>$(MSBuildThisFileDirectory)..\..\..\MusicTracker\bin\$(Configuration)\plugins\</HostBinPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(HostBinPluginsDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\MusicTracker\bin\$(Configuration)')" />
    <Copy SourceFiles="$(KslArtifact)" DestinationFolder="$(HostBinPluginsDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\MusicTracker\bin\$(Configuration)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
