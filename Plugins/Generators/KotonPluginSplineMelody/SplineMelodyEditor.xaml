<UserControl x:Class="KotonPluginSplineMelody.SplineMelodyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720" MinHeight="380" Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ParamLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource KotonTextDim}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,10,0,3"/>
            </Style>
            <Style x:Key="ValueLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource KotonTextLo}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="0" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Colonne GAUCHE : paramètres généraux ============ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Voix" Style="{StaticResource ParamLabel}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cboVoiceCount" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Durée (mesures)" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="cboBars" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Note de départ" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="cboStartMode" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="MIDI de départ (si Fixe)" Style="{StaticResource ParamLabel}"/>
                    <TextBox x:Name="txtStartMidi" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Ambitus" Style="{StaticResource ParamLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sldAmbitus" Minimum="1" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblAmbitus" Grid.Column="1" Style="{StaticResource ValueLabel}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Interpolation" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="cboInterp" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Vélocité" Style="{StaticResource ParamLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sldVelocity" Minimum="1" Maximum="127" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblVelocity" Grid.Column="1" Style="{StaticResource ValueLabel}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Articulation" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="cboArticulation" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Colonne DROITE : TabControl (Contours / Rythmes) ============ -->
            <TabControl Grid.Column="2" x:Name="tabsMain">
                <TabItem Header="Contours">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Clic gauche : ajoute un point. Glisser : déplace. Clic droit sur un point : supprime."
                                   Foreground="{DynamicResource KotonTextLo}" FontStyle="Italic" FontSize="10"
                                   Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="1" x:Name="voiceChipsContours" Orientation="Horizontal" Margin="0,0,0,8"/>
                        <ContentControl Grid.Row="2" x:Name="canvasHost"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Rythmes">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" x:Name="voiceChipsRhythms" Orientation="Horizontal" Margin="0,0,0,8"/>
                        <ContentControl Grid.Row="1" x:Name="rhythmHost"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
