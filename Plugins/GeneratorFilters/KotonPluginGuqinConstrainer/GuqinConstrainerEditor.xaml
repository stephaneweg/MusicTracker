<UserControl x:Class="KotonPluginGuqinConstrainer.GuqinConstrainerEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="1100" MinHeight="360" Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ParamLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource KotonTextDim}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,10,0,3"/>
            </Style>
            <Style x:Key="ValueLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource KotonTextLo}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="0" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Diapason (cm)" Style="{StaticResource ParamLabel}" Margin="0,0,0,3"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                        <Slider x:Name="sldDiapason" Minimum="50" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblDiapason" Grid.Column="1" Style="{StaticResource ValueLabel}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Empan main (cm)" Style="{StaticResource ParamLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                        <Slider x:Name="sldSpan" Minimum="5" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblSpan" Grid.Column="1" Style="{StaticResource ValueLabel}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Doigts max" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="cboFingers" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Hors tessiture / hors fingering" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="cboSnap" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Nombre de cordes" Style="{StaticResource ParamLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                        <Slider x:Name="sldStringCount" Minimum="2" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblStringCount" Grid.Column="1" Style="{StaticResource ValueLabel}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Accordage" Style="{StaticResource ParamLabel}"/>
                    <StackPanel x:Name="stkPresets" Orientation="Vertical"/>
                    <StackPanel x:Name="stkStrings" Orientation="Vertical" Margin="0,6,0,0"/>

                    <TextBlock Text="Ce constrainer contraint les notes reçues à des fingerings guqin jouables (cordes × hui, max N doigts, empan ≤ N cm). Le SON est produit par l'instrument de la piste — au choix : Guqin, Piano, ou n'importe quoi d'autre." TextWrapping="Wrap" Foreground="{DynamicResource KotonTextLo}" FontStyle="Italic" FontSize="10" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="{DynamicResource KotonPanel}" BorderBrush="{DynamicResource KotonBorder}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Vue guqin — les doigtés apparaissent au flatten du bloc"
                               Foreground="{DynamicResource KotonTextLo}" FontStyle="Italic" FontSize="10"
                               Margin="10,8,10,4"/>
                    <ContentControl Grid.Row="1" x:Name="canvasHost"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
