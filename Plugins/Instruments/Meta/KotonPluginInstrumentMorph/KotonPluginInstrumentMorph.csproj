<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KotonPluginInstrumentMorph</RootNamespace>
    <AssemblyName>KotonPluginInstrumentMorph</AssemblyName>
    <ProjectGuid>{B3D5E7F9-1A2C-4B4D-8E5F-6A7B8C9D0E1F}</ProjectGuid>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TargetExt>.ksl</TargetExt>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KotonStudioLibrary\KotonStudioLibrary.csproj" />
  </ItemGroup>
  <Target Name="CopyKslToHostBinPluginsDir" AfterTargets="Build">
    <PropertyGroup>
      <KslArtifact>$(TargetPath)</KslArtifact>
      <HostBinPluginsDir>$(MSBuildThisFileDirectory)..\MusicTracker\bin\$(Configuration)\plugins\</HostBinPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(HostBinPluginsDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\MusicTracker\bin\$(Configuration)')" />
    <Copy SourceFiles="$(KslArtifact)" DestinationFolder="$(HostBinPluginsDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\MusicTracker\bin\$(Configuration)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
