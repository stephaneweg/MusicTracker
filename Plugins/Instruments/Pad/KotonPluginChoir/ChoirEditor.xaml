<UserControl x:Class="KotonPluginChoir.ChoirEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="560" MinHeight="320" Background="Transparent">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Border Padding="16">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="Sub-voices" Foreground="{DynamicResource KotonAccent}" FontWeight="Bold"/><Slider x:Name="S1" Minimum="3" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock x:Name="V1" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Detune spread (cent)" Foreground="{DynamicResource KotonText}"/><Slider x:Name="S2" Minimum="5" Maximum="40" TickFrequency="1"/><TextBlock x:Name="V2" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Text="Pan spread" Foreground="{DynamicResource KotonText}"/><Slider x:Name="S3" Minimum="0" Maximum="1" TickFrequency="0.05"/><TextBlock x:Name="V3" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="0"><TextBlock Text="Vowel morph rate (Hz)" Foreground="{DynamicResource KotonAccent}" FontWeight="Bold"/><Slider x:Name="S4" Minimum="0" Maximum="0.5" TickFrequency="0.01"/><TextBlock x:Name="V4" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="0"><TextBlock Text="Vowel morph amount" Foreground="{DynamicResource KotonText}"/><Slider x:Name="S5" Minimum="0" Maximum="1" TickFrequency="0.05"/><TextBlock x:Name="V5" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="Formant Q" Foreground="{DynamicResource KotonText}"/><Slider x:Name="S6" Minimum="2" Maximum="10" TickFrequency="0.5"/><TextBlock x:Name="V6" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Air (souffle)" Foreground="{DynamicResource KotonText}"/><Slider x:Name="S7" Minimum="0" Maximum="1" TickFrequency="0.05"/><TextBlock x:Name="V7" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Attack (ms)" Foreground="{DynamicResource KotonText}"/><Slider x:Name="S8" Minimum="100" Maximum="3000" TickFrequency="50"/><TextBlock x:Name="V8" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2"><TextBlock Text="Release (ms)" Foreground="{DynamicResource KotonText}"/><Slider x:Name="S9" Minimum="200" Maximum="5000" TickFrequency="100"/><TextBlock x:Name="V9" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="Volume (dB)" Foreground="{DynamicResource KotonText}"/><Slider x:Name="S10" Minimum="-30" Maximum="6" TickFrequency="1"/><TextBlock x:Name="V10" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/></StackPanel>
        </Grid>
    </Border>
</UserControl>
