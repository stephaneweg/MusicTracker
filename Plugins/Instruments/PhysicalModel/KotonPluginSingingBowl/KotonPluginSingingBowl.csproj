<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KotonPluginSingingBowl</RootNamespace>
    <AssemblyName>KotonPluginSingingBowl</AssemblyName>
    <ProjectGuid>{B2C3D4E5-F6A7-4B8C-9D01-2E3F4A5B6C72}</ProjectGuid>
    <Nullable>disable</Nullable><LangVersion>latest</LangVersion><Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo><Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><TargetExt>.ksl</TargetExt>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\..\..\..\KotonStudioLibrary\KotonStudioLibrary.csproj" />
    <Compile Include="..\..\..\Shared\KotonReAttack.cs" Link="KotonReAttack.cs" /></ItemGroup>
  <Target Name="CopyKsl" AfterTargets="Build">
    <PropertyGroup><HostDir>$(MSBuildThisFileDirectory)..\..\..\..\MusicTracker\bin\$(Configuration)\plugins\</HostDir></PropertyGroup>
    <MakeDir Directories="$(HostDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\MusicTracker\bin\$(Configuration)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HostDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\MusicTracker\bin\$(Configuration)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
