<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KotonPluginHandpan</RootNamespace>
    <AssemblyName>KotonPluginHandpan</AssemblyName>
    <ProjectGuid>{B4C7E9A2-3F5D-4A8B-9E1C-7A3D8B4C5F92}</ProjectGuid>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TargetExt>.ksl</TargetExt>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\KotonStudioLibrary\KotonStudioLibrary.csproj" />
    <Compile Include="..\..\..\Shared\KotonReAttack.cs" Link="KotonReAttack.cs" />
  </ItemGroup>

  <Target Name="CopyKslToHostBinPluginsDir" AfterTargets="Build">
    <PropertyGroup>
      <KslArtifact>$(TargetPath)</KslArtifact>
      <HostBinPluginsDir>$(MSBuildThisFileDirectory)..\..\..\..\MusicTracker\bin\$(Configuration)\plugins\</HostBinPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(HostBinPluginsDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\MusicTracker\bin\$(Configuration)')" />
    <Copy SourceFiles="$(KslArtifact)"
          DestinationFolder="$(HostBinPluginsDir)"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\MusicTracker\bin\$(Configuration)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
