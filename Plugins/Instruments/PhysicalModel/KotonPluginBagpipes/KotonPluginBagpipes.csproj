<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KotonPluginBagpipes</RootNamespace>
    <AssemblyName>KotonPluginBagpipes</AssemblyName>
    <ProjectGuid>{A8B9C0D1-3456-4A0B-8C1D-9E0F1A2B3CBE}</ProjectGuid>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TargetExt>.ksl</TargetExt>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\..\..\..\KotonStudioLibrary\KotonStudioLibrary.csproj" />
    <Compile Include="..\..\..\Shared\KotonReAttack.cs" Link="KotonReAttack.cs" /></ItemGroup>
  <Target Name="CopyKslToHostBinPluginsDir" AfterTargets="Build">
    <PropertyGroup>
      <KslArtifact>$(TargetPath)</KslArtifact>
      <HostBinPluginsDir>$(MSBuildThisFileDirectory)..\..\..\..\MusicTracker\bin\$(Configuration)\plugins\</HostBinPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(HostBinPluginsDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\MusicTracker\bin\$(Configuration)')" />
    <Copy SourceFiles="$(KslArtifact)" DestinationFolder="$(HostBinPluginsDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\MusicTracker\bin\$(Configuration)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
