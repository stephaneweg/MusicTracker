<UserControl x:Class="KotonPluginGuqinVirtuel.GuqinVirtuelEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="740" MinHeight="380" Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ParamLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource KotonTextDim}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,10,0,3"/>
            </Style>
            <Style x:Key="ValueLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource KotonTextLo}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="0" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Colonne GAUCHE : paramètres -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Accordage" Style="{StaticResource ParamLabel}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cboTuning" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Diapason (cm)" Style="{StaticResource ParamLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sldDiapason" Minimum="50" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblDiapason" Grid.Column="1" Style="{StaticResource ValueLabel}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Empan main (cm)" Style="{StaticResource ParamLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="sldSpan" Minimum="5" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblSpan" Grid.Column="1" Style="{StaticResource ValueLabel}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Doigts max" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="cboFingers" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Snap hors gamme" Style="{StaticResource ParamLabel}"/>
                    <ComboBox x:Name="cboSnap" HorizontalAlignment="Stretch"/>

                    <Rectangle Height="1" Fill="{DynamicResource KotonBorder}" Margin="0,14,0,4"/>
                    <TextBlock Text="DSP" Foreground="{DynamicResource KotonText}" FontWeight="Bold" FontSize="11" Margin="0,4,0,4"/>

                    <TextBlock Text="Sustain" Style="{StaticResource ParamLabel}"/>
                    <Slider x:Name="sldSustain" Minimum="0" Maximum="1" TickFrequency="0.05"/>

                    <TextBlock Text="HF damping" Style="{StaticResource ParamLabel}"/>
                    <Slider x:Name="sldDamping" Minimum="0" Maximum="1" TickFrequency="0.05"/>

                    <TextBlock Text="Pluck brightness" Style="{StaticResource ParamLabel}"/>
                    <Slider x:Name="sldBright" Minimum="0" Maximum="1" TickFrequency="0.05"/>

                    <TextBlock Text="Body resonance" Style="{StaticResource ParamLabel}"/>
                    <Slider x:Name="sldBody" Minimum="0" Maximum="1" TickFrequency="0.05"/>

                    <TextBlock Text="Volume (dB)" Style="{StaticResource ParamLabel}"/>
                    <Slider x:Name="sldVolume" Minimum="-30" Maximum="6" TickFrequency="1"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Colonne DROITE : visualisation -->
            <Border Grid.Column="2" Background="{DynamicResource KotonPanel}" BorderBrush="{DynamicResource KotonBorder}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Vue guqin (7 cordes × 13 hui) — les doigtés actifs s'affichent en temps réel"
                               Foreground="{DynamicResource KotonTextLo}" FontStyle="Italic" FontSize="10"
                               Margin="10,8,10,4"/>
                    <ContentControl Grid.Row="1" x:Name="canvasHost"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
