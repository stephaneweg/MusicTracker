<UserControl x:Class="KotonPluginFaustWoodwinds.FaustWoodwindsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="600" MinHeight="360" Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Clarinette FAUST · port physmodels.lib" Foreground="{DynamicResource KotonTextLo}" FontStyle="Italic" Margin="0,0,0,14"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Air pressure" Foreground="{DynamicResource KotonAccent}" FontWeight="Bold"/>
                    <Slider x:Name="PressureSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="PressureValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Reed stiffness" Foreground="{DynamicResource KotonAccent}" FontWeight="Bold"/>
                    <Slider x:Name="ReedStiffnessSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="ReedStiffnessValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Bell opening" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="BellOpeningSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="BellOpeningValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Breath noise" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="BreathNoiseSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="BreathNoiseValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Vibrato rate (Hz)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="VibratoRateSlider" Minimum="0" Maximum="8" TickFrequency="0.5"/>
                    <TextBlock x:Name="VibratoRateValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Vibrato depth (ct)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="VibratoDepthSlider" Minimum="0" Maximum="30" TickFrequency="1"/>
                    <TextBlock x:Name="VibratoDepthValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Attack (s)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="AttackSlider" Minimum="0.005" Maximum="0.5" TickFrequency="0.01"/>
                    <TextBlock x:Name="AttackValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Release (s)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="ReleaseSlider" Minimum="0.02" Maximum="1.5" TickFrequency="0.05"/>
                    <TextBlock x:Name="ReleaseValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                    <TextBlock Text="Output gain" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="OutputGainSlider" Minimum="0" Maximum="2" TickFrequency="0.1"/>
                    <TextBlock x:Name="OutputGainValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,10">
                    <TextBlock Text="Volume (dB)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="VolumeSlider" Minimum="-30" Maximum="6" TickFrequency="1"/>
                    <TextBlock x:Name="VolumeValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
