<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KotonPluginAuroraShimmer</RootNamespace>
    <AssemblyName>KotonPluginAuroraShimmer</AssemblyName>
    <ProjectGuid>{A1B2C3D4-E5F6-4A7B-8C9D-1E2F3A4B5C61}</ProjectGuid>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TargetExt>.ksl</TargetExt>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\..\..\KotonStudioLibrary\KotonStudioLibrary.csproj" /></ItemGroup>
  <Target Name="CopyKsl" AfterTargets="Build">
    <PropertyGroup>
      <HostDir>$(MSBuildThisFileDirectory)..\..\..\MusicTracker\bin\$(Configuration)\plugins\</HostDir>
    </PropertyGroup>
    <MakeDir Directories="$(HostDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\MusicTracker\bin\$(Configuration)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HostDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\MusicTracker\bin\$(Configuration)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
