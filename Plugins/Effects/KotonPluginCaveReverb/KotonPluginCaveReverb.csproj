<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KotonPluginCaveReverb</RootNamespace>
    <AssemblyName>KotonPluginCaveReverb</AssemblyName>
    <ProjectGuid>{C5D8F2A4-6E9B-4B2C-8F1E-9A3C7D5B4E82}</ProjectGuid>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TargetExt>.ksl</TargetExt>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KotonStudioLibrary\KotonStudioLibrary.csproj" />
  </ItemGroup>

  <Target Name="CopyKslToHostBinPluginsDir" AfterTargets="Build">
    <PropertyGroup>
      <KslArtifact>$(TargetPath)</KslArtifact>
      <HostBinPluginsDir>$(MSBuildThisFileDirectory)..\MusicTracker\bin\$(Configuration)\plugins\</HostBinPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(HostBinPluginsDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\MusicTracker\bin\$(Configuration)')" />
    <Copy SourceFiles="$(KslArtifact)"
          DestinationFolder="$(HostBinPluginsDir)"
          Condition="Exists('$(MSBuildThisFileDirectory)..\MusicTracker\bin\$(Configuration)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
