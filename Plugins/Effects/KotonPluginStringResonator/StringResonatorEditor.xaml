<UserControl x:Class="KotonPluginStringResonator.StringResonatorEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="560" MinHeight="360" Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Bandeau : preset + témoin d'accroche du suiveur. -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Preset :" VerticalAlignment="Center" Foreground="{DynamicResource KotonText}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="PresetCombo" Width="200" HorizontalAlignment="Left" SelectionChanged="PresetCombo_SelectionChanged"/>
                <TextBlock Grid.Column="2" x:Name="TrackLabel" Foreground="{DynamicResource KotonTextLo}" FontStyle="Italic" VerticalAlignment="Center"/>
            </Grid>

            <!-- Accord : suivi de l'entrée, ou note fixe. -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Accord :" VerticalAlignment="Center" Foreground="{DynamicResource KotonAccent}" FontWeight="Bold" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="TuneCombo" Width="230" SelectionChanged="TuneCombo_SelectionChanged"/>
                <TextBlock Grid.Column="2" x:Name="FixedNoteLabel" Text="Note fixe" VerticalAlignment="Center" Foreground="{DynamicResource KotonText}" Margin="16,0,10,0"/>
                <StackPanel Grid.Column="3" x:Name="FixedNotePanel">
                    <Slider x:Name="FixedNoteSlider" Minimum="24" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="FixedNoteValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Décroissance (longueur de la corde dans le temps)" Foreground="{DynamicResource KotonAccent}" FontWeight="Bold"/>
                    <Slider x:Name="DecaySlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="DecayValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Brillance (amortissement des aigus)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="ToneSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="ToneValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Excitation (dose d'entrée injectée dans la corde)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="DriveSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="DriveValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Intervalle (transposition de la corde)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="IntervalSlider" Minimum="-24" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="IntervalValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Désaccord (2e corde, largeur stéréo)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="SpreadSlider" Minimum="0" Maximum="30" TickFrequency="1"/>
                    <TextBlock x:Name="SpreadValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Note la plus grave de l'instrument" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="LowNoteSlider" Minimum="24" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="LowNoteValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Mix (sec / corde)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="MixSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="MixValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Sortie" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="OutGainSlider" Minimum="-30" Maximum="12" TickFrequency="1"/>
                    <TextBlock x:Name="OutGainValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Garde-fous du suivi : mêmes leviers que la détection du rack live. -->
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Écart max (refuse les sauts aberrants)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="MaxLeapSlider" Minimum="0" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="MaxLeapValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Anti-sous-harmonique (erreur d'octave basse)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="GuardSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="GuardValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource KotonTextLo}" FontSize="10"
                           Text="La corde est excitée par le signal d'entrée et s'accorde en continu sur sa hauteur : le vibrato, les glissandos et les nuances du jeu passent tels quels. Aucune note n'est détectée ni quantifiée."/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
