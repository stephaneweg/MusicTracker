<UserControl x:Class="KotonPluginShimmerSparkle.ShimmerSparkleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="640" MinHeight="380"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Preset :" VerticalAlignment="Center" Foreground="{DynamicResource KotonText}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="PresetCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="PresetCombo_SelectionChanged"/>
                <CheckBox Grid.Column="2" x:Name="MixLockCheck" Content="Mix lock" VerticalAlignment="Center" Margin="10,0,10,0" Foreground="{DynamicResource KotonText}"/>
                <TextBlock Grid.Column="3" Text="Shimmer + Sparkle · magique" Foreground="{DynamicResource KotonTextLo}" FontStyle="Italic" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Col 1 : Reverb / Shimmer -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Reverb size" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="SizeSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="SizeValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Reverb decay" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="DecaySlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="DecayValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="HF damping" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="DampingSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="DampingValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Pre-delay (ms)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="PreDelaySlider" Minimum="0" Maximum="200" TickFrequency="5"/>
                    <TextBlock x:Name="PreDelayValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Col 2 : Shimmer + Sparkle key/scale -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Shimmer amount" Foreground="{DynamicResource KotonAccent}" FontWeight="Bold"/>
                    <Slider x:Name="ShimmerSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="ShimmerValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Shimmer interval (semis)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="ShimmerSemisSlider" Minimum="-12" Maximum="24" TickFrequency="1"/>
                    <TextBlock x:Name="ShimmerSemisValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Sparkle key" Foreground="{DynamicResource KotonText}"/>
                    <ComboBox x:Name="KeyCombo" SelectionChanged="KeyCombo_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Sparkle scale" Foreground="{DynamicResource KotonText}"/>
                    <ComboBox x:Name="ScaleCombo" SelectionChanged="ScaleCombo_SelectionChanged"/>
                </StackPanel>

                <!-- Col 3 : Sparkle density/gain/range + mix/out -->
                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                    <TextBlock Text="Sparkle density" Foreground="{DynamicResource KotonAccent}" FontWeight="Bold"/>
                    <Slider x:Name="SparkleAmtSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="SparkleAmtValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,10">
                    <TextBlock Text="Sparkle level" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="SparkleGainSlider" Minimum="0" Maximum="1.5" TickFrequency="0.05"/>
                    <TextBlock x:Name="SparkleGainValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,0,0,10">
                    <TextBlock Text="Sparkle decay (ms)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="SparkleDecaySlider" Minimum="50" Maximum="2000" TickFrequency="50"/>
                    <TextBlock x:Name="SparkleDecayValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="4" Margin="0,0,0,10">
                    <CheckBox x:Name="TrigCheck" Content="Trigger sur entrée" Foreground="{DynamicResource KotonText}" Checked="TrigCheck_Changed" Unchecked="TrigCheck_Changed"/>
                    <TextBlock Text="(sinon Poisson libre)" Foreground="{DynamicResource KotonTextLo}" FontSize="9"/>
                </StackPanel>

                <!-- Ligne 4 : range + mix + out (spans) -->
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Sparkle low (MIDI)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="SparkleLoSlider" Minimum="36" Maximum="96" TickFrequency="12"/>
                    <TextBlock x:Name="SparkleLoValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Sparkle high (MIDI)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="SparkleHiSlider" Minimum="36" Maximum="108" TickFrequency="12"/>
                    <TextBlock x:Name="SparkleHiValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="4" Margin="0,0,0,10">
                    <TextBlock Text="Mix dry/wet" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="MixSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="MixValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                    <TextBlock Text="Output (dB)" Foreground="{DynamicResource KotonText}" Margin="0,6,0,0"/>
                    <Slider x:Name="OutGainSlider" Minimum="-30" Maximum="6" TickFrequency="1"/>
                    <TextBlock x:Name="OutGainValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
