<UserControl x:Class="KotonPluginForest.ForestEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="620" MinHeight="400"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderThickness="0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Preset :" VerticalAlignment="Center"
                           Foreground="{DynamicResource KotonText}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="PresetCombo" Width="220" HorizontalAlignment="Left"
                          SelectionChanged="PresetCombo_SelectionChanged"/>
                <CheckBox Grid.Column="2" x:Name="MixLockCheck" Content="Mix lock"
                          VerticalAlignment="Center" Margin="10,0,10,0"
                          Foreground="{DynamicResource KotonText}"
                          ToolTip="Preserve Mix lors du parcours des presets"/>
                <TextBlock Grid.Column="3" Text="Forest · ambience fragmentee"
                           Foreground="{DynamicResource KotonTextLo}" FontStyle="Italic"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Colonne 1 : STRUCTURE (fragmentation / queue) -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Density (troncs/branches)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="DensitySlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="DensityValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Decay" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="DecaySlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="DecayValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Absorption (feuillage)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="AbsorptionSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="AbsorptionValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Pre-delay (ms)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="PreDelaySlider" Minimum="0" Maximum="100" TickFrequency="1"/>
                    <TextBlock x:Name="PreDelayValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Colonne 2 : RUSTLE / WIND -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Rustle (feuilles)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="RustleSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="RustleValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Rustle rate" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="RustleRateSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="RustleRateValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Wind (mouvement pan)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="WindMovementSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="WindMovementValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="HP filter (Hz)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="HpFilterSlider" Minimum="20" Maximum="800" TickFrequency="10"/>
                    <TextBlock x:Name="HpFilterValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Colonne 3 : SORTIE -->
                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                    <TextBlock Text="Stereo width" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="StereoWidthSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="StereoWidthValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,10">
                    <TextBlock Text="Mix (dry/wet)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="MixSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="MixValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,0,0,10">
                    <TextBlock Text="Output (dB)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="OutGainSlider" Minimum="-30" Maximum="6" TickFrequency="1"/>
                    <TextBlock x:Name="OutGainValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
