<UserControl x:Class="KotonPluginFractal.FractalEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="620" MinHeight="480"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderThickness="0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Bandeau du haut : algo + regenerer -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Algo :" VerticalAlignment="Center"
                           Foreground="{DynamicResource KotonText}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="AlgoCombo" Width="220"
                          SelectionChanged="AlgoCombo_SelectionChanged"/>

                <Button Grid.Column="3" x:Name="RerollButton" Content="🎲 Régénérer"
                        Padding="12,4" Click="RerollButton_Click"/>
            </Grid>

            <!-- Bandeau paramètres COMMUNS (visible en permanence) -->
            <Border Grid.Row="1" BorderThickness="0" Padding="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Colonne 1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Notes / temps" Foreground="{DynamicResource KotonText}"/>
                        <ComboBox x:Name="NotesPerBeatCombo" SelectionChanged="NotesPerBeatCombo_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Snap" Foreground="{DynamicResource KotonText}"/>
                        <ComboBox x:Name="SnapCombo" SelectionChanged="SnapCombo_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="Articulation" Foreground="{DynamicResource KotonText}"/>
                        <ComboBox x:Name="ArticulationCombo" SelectionChanged="ArticulationCombo_SelectionChanged"/>
                    </StackPanel>

                    <!-- Colonne 2 -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Octave" Foreground="{DynamicResource KotonText}"/>
                        <Slider x:Name="OctaveSlider" Minimum="0" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="OctaveValue" Foreground="{DynamicResource KotonTextDim}"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Range (demi-tons)" Foreground="{DynamicResource KotonText}"/>
                        <Slider x:Name="RangeSlider" Minimum="12" Maximum="48" TickFrequency="1"/>
                        <TextBlock x:Name="RangeValue" Foreground="{DynamicResource KotonTextDim}"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="Seed" Foreground="{DynamicResource KotonText}"/>
                        <Slider x:Name="SeedSlider" Minimum="0" Maximum="999" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="SeedValue" Foreground="{DynamicResource KotonTextDim}"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Colonne 3 -->
                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="Vélocité" Foreground="{DynamicResource KotonText}"/>
                        <Slider x:Name="VelocitySlider" Minimum="1" Maximum="127" TickFrequency="1"/>
                        <TextBlock x:Name="VelocityValue" Foreground="{DynamicResource KotonTextDim}"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="Variation vélocité" Foreground="{DynamicResource KotonText}"/>
                        <Slider x:Name="VelVarSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                        <TextBlock x:Name="VelVarValue" Foreground="{DynamicResource KotonTextDim}"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="Durée (temps)" Foreground="{DynamicResource KotonText}"/>
                        <Slider x:Name="DurationSlider" Minimum="0.25" Maximum="32" TickFrequency="0.25"/>
                        <TextBlock x:Name="DurationValue" Foreground="{DynamicResource KotonTextDim}"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bandeau paramètres SPÉCIFIQUES : un Border par algo, un seul visible à la fois -->
            <Grid Grid.Row="2" Margin="0,6,0,0">

                <!-- === VOSS === -->
                <Border x:Name="VossPanel" BorderThickness="1" BorderBrush="{DynamicResource KotonBorder}"
                        Padding="12" CornerRadius="4" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Voss-Clarke 1/f" FontWeight="Bold"
                                   Foreground="{DynamicResource KotonAccent}" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource KotonTextDim}"
                                   FontStyle="Italic" Margin="0,0,0,10"
                                   Text="Bruit rose 1/f par sommation de N dés à cadences 1, 2, 4, 8… &#x2014; le fondement de la fractale musicale (Voss &amp; Clarke, 1975)."/>
                        <TextBlock Text="Nombre de dés (octaves)" Foreground="{DynamicResource KotonText}"/>
                        <Slider x:Name="VossOctavesSlider" Minimum="2" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="VossOctavesValue" Foreground="{DynamicResource KotonTextDim}"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- === LOGISTIC === -->
                <Border x:Name="LogisticPanel" BorderThickness="1" BorderBrush="{DynamicResource KotonBorder}"
                        Padding="12" CornerRadius="4" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Logistic map" FontWeight="Bold"
                                   Foreground="{DynamicResource KotonAccent}" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource KotonTextDim}"
                                   FontStyle="Italic" Margin="0,0,0,10"
                                   Text="x_{n+1} = r · x · (1 - x). Chaos déterministe pour r &gt; 3.57. Zone très musicale : r ~ 3.7 à 3.95."/>
                        <TextBlock Text="Paramètre r" Foreground="{DynamicResource KotonText}"/>
                        <Slider x:Name="LogisticRSlider" Minimum="2.5" Maximum="4.0" TickFrequency="0.01"/>
                        <TextBlock x:Name="LogisticRValue" Foreground="{DynamicResource KotonTextDim}"
                                   FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- === LORENZ === -->
                <Border x:Name="LorenzPanel" BorderThickness="1" BorderBrush="{DynamicResource KotonBorder}"
                        Padding="12" CornerRadius="4" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Lorenz attractor" FontWeight="Bold"
                                   Foreground="{DynamicResource KotonAccent}" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource KotonTextDim}"
                                   FontStyle="Italic" Margin="0,0,0,10"
                                   Text="Le fameux attracteur en papillon (Lorenz, 1963). σ=10, ρ=28, β=8/3. Trois axes disponibles &#x2014; l'axe Y donne le plus de variation, Z sonne comme des cloches d'énergie."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Vitesse (dt)" Foreground="{DynamicResource KotonText}"/>
                                <Slider x:Name="LorenzSpeedSlider" Minimum="0.001" Maximum="0.05" TickFrequency="0.001"/>
                                <TextBlock x:Name="LorenzSpeedValue" Foreground="{DynamicResource KotonTextDim}"
                                           FontSize="10" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Axe" Foreground="{DynamicResource KotonText}"/>
                                <ComboBox x:Name="LorenzDimCombo" SelectionChanged="LorenzDimCombo_SelectionChanged"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Barre du bas : Preview -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="PreviewButton" Content="▶ Preview" Padding="12,4" Margin="0,0,6,0" Click="PreviewButton_Click"/>
                <Button x:Name="StopButton" Content="⏹ Stop" Padding="12,4" Click="StopButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
