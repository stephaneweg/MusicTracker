<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    Palette + styles partages pour TOUS les plugins Koton (KotonPluginFmSynth, KotonPluginArpeggiator,
    KotonPluginWaveMorph, futurs plugins).

    Utilisation dans un plugin :
        <UserControl.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
                </ResourceDictionary.MergedDictionaries>
                <!- redefinitions ou styles locaux du plugin ici ->
            </ResourceDictionary>
        </UserControl.Resources>

    Pourquoi ici et pas dans MusicTracker : un plugin .ksl est un assembly independant qui n'a
    aucune reference sur MusicTracker.dll (contrat "plugin auto-suffisant"). KotonStudioLibrary est
    la SEULE dependance commune legitime — c'est donc le bon endroit pour les ressources partagees.
    -->

    <!-- ================ Palette Koton ================ -->
    <SolidColorBrush x:Key="KotonGround"    Color="#16161c"/>
    <SolidColorBrush x:Key="KotonPanel"     Color="#22222a"/>
    <SolidColorBrush x:Key="KotonPanelHi"   Color="#2c2c36"/>
    <SolidColorBrush x:Key="KotonBorder"    Color="#35353f"/>
    <SolidColorBrush x:Key="KotonBorderHi"  Color="#4a4a55"/>
    <SolidColorBrush x:Key="KotonAccent"    Color="#1FB6C3"/>
    <SolidColorBrush x:Key="KotonAccentDim" Color="#0F7A88"/>
    <SolidColorBrush x:Key="KotonText"      Color="#DDDDDD"/>
    <SolidColorBrush x:Key="KotonTextDim"   Color="#888888"/>
    <SolidColorBrush x:Key="KotonTextLo"    Color="#5c5c66"/>

    <!-- ================ Styles IMPLICITES ================ -->
    <!-- Sans x:Key : s'appliquent automatiquement a tous les controles du type dans le UserControl
         qui merge ce dictionary. Un plugin qui veut un style specifique peut redefinir un style
         nomme localement et le referencer explicitement. -->

    <!-- ComboBox : dark theme avec dropdown lisible (l'ItemContainerStyle interne cible les items
         du popup, sinon ils gardent le default WPF fond blanc = illisible en dark). -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource KotonPanelHi}"/>
        <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KotonBorder}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
                    <Setter Property="Background" Value="{StaticResource KotonPanelHi}"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{StaticResource KotonAccentDim}"/>
                            <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource KotonAccent}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button : cohere avec le dark theme, hover en teal accent. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource KotonPanelHi}"/>
        <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KotonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource KotonBorderHi}"/>
                <Setter Property="Foreground" Value="{StaticResource KotonAccent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource KotonPanelHi}"/>
        <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KotonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="CaretBrush" Value="{StaticResource KotonAccent}"/>
    </Style>

    <!-- CheckBox. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
        <Setter Property="Background" Value="{StaticResource KotonPanelHi}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KotonBorder}"/>
    </Style>

    <!-- Slider : teal accent. -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource KotonAccent}"/>
        <Setter Property="Background" Value="{StaticResource KotonBorder}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
    </Style>

    <!-- Label + TextBlock : couleur de texte par defaut. -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
    </Style>

    <!-- ScrollBar : theme sombre discret (le default WPF est trop clair sur fond noir). -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource KotonPanel}"/>
        <Setter Property="Foreground" Value="{StaticResource KotonBorderHi}"/>
    </Style>

</ResourceDictionary>
