<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    Palette + styles partages pour TOUS les plugins Koton (KotonPluginFmSynth, KotonPluginArpeggiator,
    KotonPluginWaveMorph, futurs plugins).

    Utilisation dans un plugin :
        <UserControl.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </UserControl.Resources>

    Pourquoi ici et pas dans MusicTracker : un plugin .ksl est un assembly independant qui n'a
    aucune reference sur MusicTracker.dll. KotonStudioLibrary est la SEULE dependance commune
    legitime — c'est donc le bon endroit pour les ressources partagees.
    -->

    <!-- ================ Palette Koton ================ -->
    <SolidColorBrush x:Key="KotonGround"    Color="#16161c"/>
    <SolidColorBrush x:Key="KotonPanel"     Color="#22222a"/>
    <SolidColorBrush x:Key="KotonPanelHi"   Color="#2c2c36"/>
    <SolidColorBrush x:Key="KotonBorder"    Color="#35353f"/>
    <SolidColorBrush x:Key="KotonBorderHi"  Color="#4a4a55"/>
    <SolidColorBrush x:Key="KotonAccent"    Color="#1FB6C3"/>
    <SolidColorBrush x:Key="KotonAccentDim" Color="#0F7A88"/>
    <SolidColorBrush x:Key="KotonText"      Color="#DDDDDD"/>
    <SolidColorBrush x:Key="KotonTextDim"   Color="#888888"/>
    <SolidColorBrush x:Key="KotonTextLo"    Color="#5c5c66"/>

    <!-- ================ ComboBox : template complet ================ -->
    <!-- Un simple Setter ne suffit pas — WPF a un ControlTemplate default qui rend le popup
         avec le systeme, fond blanc = illisible en dark theme. On re-templater completement. -->

    <!-- Template du ToggleButton (partie visible avec la fleche) -->
    <ControlTemplate x:Key="KotonComboToggle" TargetType="ToggleButton">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="MainBorder" Grid.ColumnSpan="2"
                    Background="{StaticResource KotonPanelHi}"
                    BorderBrush="{StaticResource KotonBorder}"
                    BorderThickness="1" CornerRadius="2"/>
            <Path x:Name="Arrow" Grid.Column="1"
                  Fill="{StaticResource KotonTextDim}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M 0 0 L 4 4 L 8 0 Z"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource KotonBorderHi}"/>
                <Setter TargetName="Arrow"      Property="Fill"        Value="{StaticResource KotonText}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource KotonAccentDim}"/>
                <Setter TargetName="Arrow"      Property="Fill"        Value="{StaticResource KotonAccent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Style ComboBoxItem (chaque item du dropdown) -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
        <Setter Property="Background" Value="{StaticResource KotonPanelHi}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource KotonAccentDim}"/>
                            <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource KotonAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style ComboBox complet -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
        <Setter Property="Background" Value="{StaticResource KotonPanelHi}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KotonBorder}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Name="ToggleButton"
                                      Template="{StaticResource KotonComboToggle}"
                                      Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                        <ContentPresenter Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="6,2,22,2"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <Popup Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  SnapsToDevicePixels="True">
                                <Border Background="{StaticResource KotonPanel}"
                                        BorderBrush="{StaticResource KotonBorder}"
                                        BorderThickness="1" CornerRadius="2"/>
                                <ScrollViewer Margin="1">
                                    <ItemsPresenter SnapsToDevicePixels="True"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================ Slider ================ -->
    <!-- Poignee : gris fonce (KotonPanelHi) avec bordure claire. Fill teal du cote Min → Value,
         rail neutre du cote Value → Max. Deux styles distincts (implicite horizontal + nomme
         vertical) car le LayoutTransform Rotate casse le hit-testing en vertical. -->

    <Style x:Key="KotonSliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource KotonPanelHi}"
                            BorderBrush="{StaticResource KotonBorderHi}"
                            BorderThickness="1" CornerRadius="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumb specifique vertical : oriente autrement (large vs haut) -->
    <Style x:Key="KotonSliderThumbVertical" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource KotonPanelHi}"
                            BorderBrush="{StaticResource KotonBorderHi}"
                            BorderThickness="1" CornerRadius="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RepeatButtons : templates orientation-specifiques (le Border interne a Height fixe en
         horizontal, Width fixe en vertical, pour donner l'aspect "rail fin"). -->
    <Style x:Key="KotonSliderFillH" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource KotonAccent}" Height="4"
                            CornerRadius="2" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KotonSliderRailH" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource KotonBorder}" Height="4"
                            CornerRadius="2" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KotonSliderFillV" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource KotonAccent}" Width="4"
                            CornerRadius="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KotonSliderRailV" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource KotonBorder}" Width="4"
                            CornerRadius="2" HorizontalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider implicite : s'applique a tout Slider sans Style explicite. Le template DEFAUT est
         horizontal ; un trigger sur Orientation=Vertical bascule sur le template vertical (fill du
         bas jusqu'au thumb, rail au-dessus). Sans ce trigger, un slider Vertical utilise le template
         horizontal et rend rien (thumb + rail ecrases, cf. bug mixeur 2026-08-02). -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource KotonAccent}"/>
        <Setter Property="Background" Value="{StaticResource KotonBorder}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource KotonSliderFillH}" Command="Slider.DecreaseLarge"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource KotonSliderThumb}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource KotonSliderRailH}" Command="Slider.IncreaseLarge"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="MinWidth" Value="18"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource KotonSliderFillV}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource KotonSliderThumbVertical}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource KotonSliderRailV}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Slider VERTICAL nomme : applique explicitement via Style="{StaticResource KotonVerticalSlider}"
         Fill teal du bas (Min) jusqu'au thumb, rail neutre au-dessus. -->
    <Style x:Key="KotonVerticalSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource KotonAccent}"/>
        <Setter Property="Background" Value="{StaticResource KotonBorder}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource KotonSliderFillV}" Command="Slider.DecreaseLarge"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource KotonSliderThumbVertical}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource KotonSliderRailV}" Command="Slider.IncreaseLarge"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================ Autres controles ================ -->
    <!-- Button : template custom pour gerer proprement les etats (Normal/Hover/Pressed/Disabled)
         dans le theme dark. Sans template, WPF utilisait le style par defaut qui appliquait un fond
         blanc/gris pale en Disabled — tres visible sur le fond dark du theme. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource KotonPanelHi}"/>
        <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KotonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource KotonBorderHi}"/>
                            <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{StaticResource KotonAccent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource KotonPanel}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource KotonPanel}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource KotonBorder}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{StaticResource KotonTextLo}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource KotonPanelHi}"/>
        <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KotonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="CaretBrush" Value="{StaticResource KotonAccent}"/>
    </Style>

    <!-- CheckBox : carre 14x14 rempli couleur accent (teal) quand coche, avec petit checkmark blanc.
         Non coche = fond KotonPanelHi + bord KotonBorder. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
        <Setter Property="Background" Value="{StaticResource KotonPanelHi}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KotonBorder}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="14" Height="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                VerticalAlignment="Center">
                            <Path x:Name="Check"
                                  Data="M 2 6 L 5 10 L 12 3"
                                  Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box"   Property="Background" Value="{StaticResource KotonAccent}"/>
                            <Setter TargetName="Box"   Property="BorderBrush" Value="{StaticResource KotonAccent}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource KotonBorderHi}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource KotonText}"/>
    </Style>

</ResourceDictionary>
