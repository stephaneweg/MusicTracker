<UserControl x:Class="KotonPluginKarplusStrong.KarplusStrongEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="560" MinHeight="470"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderThickness="0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Bandeau du haut : combo preset -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Preset :" VerticalAlignment="Center"
                           Foreground="{DynamicResource KotonText}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="PresetCombo" Width="200" HorizontalAlignment="Left"
                          SelectionChanged="PresetCombo_SelectionChanged"/>

                <TextBlock Grid.Column="2" Text="Karplus–Strong · corde pincee"
                           Foreground="{DynamicResource KotonTextLo}" FontStyle="Italic"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 2 colonnes de 4 sliders chacune -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Colonne gauche : caractère de la corde -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Damping" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="DampingSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="DampingValue" Foreground="{DynamicResource KotonTextDim}"
                               FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Tone" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="ToneSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="ToneValue" Foreground="{DynamicResource KotonTextDim}"
                               FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Stiffness" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="StiffnessSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="StiffnessValue" Foreground="{DynamicResource KotonTextDim}"
                               FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Body" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="BodySlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="BodyValue" Foreground="{DynamicResource KotonTextDim}"
                               FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Colonne droite : geste d'attaque + sortie -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Pluck position" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="PluckPosSlider" Minimum="0.02" Maximum="0.5" TickFrequency="0.02"/>
                    <TextBlock x:Name="PluckPosValue" Foreground="{DynamicResource KotonTextDim}"
                               FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Pluck hardness" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="PluckHardSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="PluckHardValue" Foreground="{DynamicResource KotonTextDim}"
                               FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Stereo width" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="WidthSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="WidthValue" Foreground="{DynamicResource KotonTextDim}"
                               FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Volume (dB)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="VolumeSlider" Minimum="-30" Maximum="6" TickFrequency="1"/>
                    <TextBlock x:Name="VolumeValue" Foreground="{DynamicResource KotonTextDim}"
                               FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Sustain sur toute la largeur : pousse le gain de feedback vers 1.0
                     (independamment du damping qui reste responsable de la mort des aigus). -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                    <TextBlock Text="Sustain (0 = naturel, 1 = quasi-infini)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="SustainSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="SustainValue" Foreground="{DynamicResource KotonTextDim}"
                               FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Harmonics : reduit l'attenuation du LP KS pour preserver les aigus.
                     0 = amortissement naturel des harmoniques hautes (son doux/dark),
                     1 = harmoniques hautes preservees (son metallique/brillant/koto/sitar). -->
                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
                    <TextBlock Text="Harmonics (0 = doux, 1 = metallique)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="HarmonicsSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="HarmonicsValue" Foreground="{DynamicResource KotonTextDim}"
                               FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
