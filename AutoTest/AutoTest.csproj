<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MusicTracker.AutoTest</RootNamespace>
    <AssemblyName>MusicTracker.AutoTest</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- FlaUI 4.0.0 drags in System.Drawing.Common 5.0.2 which NuGet audit flags as vulnerable
         (GHSA-rxg9-xrhp-64gj); the harness never asks for GDI+ rendering, only for FlaUI's own
         helpers, so it's a transitive false-positive here. NU1510: System.Text.Json is in-box on
         net10 but we keep it referenced explicitly to survive a rollback. -->
    <NoWarn>$(NoWarn);NU1510;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

</Project>
