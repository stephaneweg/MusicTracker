<UserControl x:Class="KotonPluginUnderwater.UnderwaterEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="500" MinHeight="280" Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KotonStudioLibrary;component/Themes/KotonPluginTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Preset :" VerticalAlignment="Center" Foreground="{DynamicResource KotonText}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="PresetCombo" Width="200" HorizontalAlignment="Left" SelectionChanged="PresetCombo_SelectionChanged"/>
                <TextBlock Grid.Column="2" Text="Underwater · sous l'eau" Foreground="{DynamicResource KotonTextLo}" FontStyle="Italic" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Depth (profondeur = etouffement)" Foreground="{DynamicResource KotonAccent}" FontWeight="Bold"/>
                    <Slider x:Name="DepthSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="DepthValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Movement (tangage)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="MovementSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="MovementValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="Bubbles (fond)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="BubblesSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="BubblesValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="HP filter (Hz)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="HpFilterSlider" Minimum="20" Maximum="500" TickFrequency="5"/>
                    <TextBlock x:Name="HpFilterValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Mix" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="MixSlider" Minimum="0" Maximum="1" TickFrequency="0.05"/>
                    <TextBlock x:Name="MixValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Output (dB)" Foreground="{DynamicResource KotonText}"/>
                    <Slider x:Name="OutGainSlider" Minimum="-30" Maximum="6" TickFrequency="1"/>
                    <TextBlock x:Name="OutGainValue" Foreground="{DynamicResource KotonTextDim}" FontSize="10" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
